  <footer>
    <strong data-i18n="footer_army">EJÉRCITO DEL PERÚ</strong> · <span data-i18n="footer_text">Registro histórico
      oficial sobre atentados y enfrentamientos vinculados al conflicto armado interno en el Perú (1980–2026). Sala de
      Pacificación Nacional y Memoria Histórica.</span>
  </footer>

  <!-- MODAL DE DETALLE DEL HITO: FOTO + DESCRIPCIÓN Y DETALLE JUNTOS -->
  <div id="event-detail-modal" class="event-detail-modal" onclick="closeEventDetailModal()" style="display:none;">
    <div class="event-detail-dialog" onclick="event.stopPropagation()">
      <!-- Botón Cerrar -->
      <button class="modal-close-btn" onclick="closeEventDetailModal()" aria-label="Cerrar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Botón Flotante Lateral Anterior -->
      <button class="modal-nav-btn prev" onclick="navigateEventModal(-1)" title="Hito anterior">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Botón Flotante Lateral Siguiente -->
      <button class="modal-nav-btn next" onclick="navigateEventModal(1)" title="Siguiente hito">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="event-detail-grid">
        <!-- Columna Izquierda: FOTO DE LA ACCIÓN -->
        <div class="event-modal-media">
          <div class="media-frame">
            <img id="modal-event-img" src="" alt="Fotografía histórica de la acción" />
            <div id="modal-photo-badge" class="media-type-badge">FOTOGRAFÍA HISTÓRICA</div>
          </div>
        </div>

        <!-- Columna Derecha: DESCRIPCIÓN DE LA ACCIÓN Y SU DETALLE -->
        <div class="event-modal-info">
          <div>
            <!-- Barra de Metadatos -->
            <div class="modal-meta-row">
              <span id="modal-event-cat" class="modal-category-pill">ATENTADO</span>
              <span id="modal-event-date" class="modal-date-badge">17 de mayo, 1980</span>
              <span id="modal-event-counter" class="modal-counter-badge">Hito 1 / 54</span>
            </div>

            <!-- Título del Hito -->
            <h2 id="modal-event-title" class="modal-event-title">Atentado de Chuschi</h2>

            <!-- Ubicación Geográfica -->
            <div class="modal-place-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span id="modal-event-place">Cangallo, <b>Ayacucho</b></span>
            </div>

            <!-- Línea Divisoria -->
            <div class="modal-divider"></div>

            <!-- Detalle y Reseña Histórica de la Acción -->
            <div class="modal-desc-container">
              <span class="modal-desc-heading" data-i18n="modal_desc_label">RESEÑA Y DETALLE DE LA ACCIÓN:</span>
              <p id="modal-event-desc" class="modal-event-desc">
                Quema de ánforas y cédulas electorales por parte de Sendero Luminoso.
              </p>
            </div>
          </div>

          <!-- Pie Institucional -->
          <div class="modal-footer-brand">
            <span>EJÉRCITO DEL PERÚ • SALA DE PACIFICACIÓN Y MEMORIA HISTÓRICA</span>
            <button onclick="closeEventDetailModal()"
              style="background:#0f172a; border:1px solid #334155; color:#cbd5e1; border-radius:8px; padding:0.35rem 0.85rem; font-weight:800; cursor:pointer;"
              data-i18n="modal_close_btn">CERRAR</button>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
  <script>

    const I18N_DATA = {
      es: {
        eyebrow: "PERÚ · SALA DE PACIFICACIÓN Y MEMORIA HISTÓRICA",
        legend_attack: "Atentado / Masacre",
        legend_op: "Operativo / Enfrentamiento",
        title: "Cronología del <span>Terrorismo</span> en el Perú (1980 — 2026)",
        subhead: "Línea de tiempo de atentados, masacres y enfrentamientos vinculados a Sendero Luminoso y al Militarizado Partido Comunista del Perú (MPCP) en Ayacucho, Junín, Huancavelica, Cusco y la zona del VRAEM.",
        card_action_btn: "VER DETALLE Y FOTO",
        modal_desc_label: "RESEÑA Y DETALLE DE LA ACCIÓN:",
        modal_close_btn: "CERRAR",
        events: {
          "1": {

            "date": "17 de mayo, 1980",
            "cat": "Atentado",
            "title": "Atentado de Chuschi",
            "place": "Cangallo, <b>Ayacucho</b>",
            "desc": "Quema de ánforas y cédulas electorales por parte de Sendero Luminoso. <b>Marcó el inicio del accionar terrorista</b> en el Perú."
          },
          "2": {

            "date": "Fines de septiembre, 1981",
            "cat": "Atentado",
            "title": "Atentado con explosivos al Congreso de la República",
            "place": "Lima, <b>Lima</b>",
            "desc": "Un atentado con explosivos causó daños de consideración en uno de los balcones del Congreso de la República. El suceso desató un debate nacional sobre la urgencia de dotar a las fuerzas del orden de capacidad logística ante la creciente amenaza terrorista."
          },
          "3": {

            "date": "11 de octubre, 1981",
            "cat": "Ataque",
            "title": "Ataque al puesto policial de Tambo",
            "place": "Tambo, La Mar, <b>Ayacucho</b>",
            "desc": "Militantes de Sendero Luminoso perpetraron un violento asalto armado contra el puesto policial de Tambo. En la defensa fallecieron un valeroso guardia civil y dos civiles, motivando la declaración de estado de emergencia en cinco provincias de Ayacucho."
          },
          "4": {

            "date": "5 de julio, 1982",
            "cat": "Ataque",
            "title": "Ataque al puesto policial de Ñaña",
            "place": "Ñaña, <b>Lima</b>",
            "desc": "Asalto nocturno de Sendero Luminoso para apoderarse de armas y municiones. Murieron los guardias <b>Luis Muñoz</b> y <b>Luis Navarrete</b>; la valerosa defensa evitó la toma del puesto."
          },
          "5": {

            "date": "6 de octubre, 1982",
            "cat": "Ataque",
            "title": "Ataque al puesto de Mayocc",
            "place": "Mayocc, <b>Huancavelica</b> y Huanta",
            "desc": "Enfrentamiento armado entre Sendero Luminoso y la Guardia Civil en Mayocc con <b>4 policías muertos</b> y 3 heridos. En Huanta perpetraron 18 atentados con dinamita como distracción."
          },
          "6": {

            "date": "1982–1984",
            "cat": "Masacre",
            "title": "Violencia en Chungui y Oreja de Perro",
            "place": "Chungui y Oreja de Perro, <b>Ayacucho</b>",
            "desc": "Campaña sistemática de terror senderista contra comunidades rurales: <b>asesinatos masivos</b>, secuestros, desapariciones, saqueo y desplazamiento forzado de campesinos."
          },
          "7": {

            "date": "3 de abril, 1983",
            "cat": "Masacre",
            "title": "Masacre de Lucanamarca",
            "place": "Huanca Sancos, <b>Ayacucho</b>",
            "desc": "Asesinato de <b>69 comuneros</b> con hachas, machetes y armas de fuego por orden directa de Abimael Guzmán."
          },
          "8": {

            "date": "Enero y Julio, 1984",
            "cat": "Incursión",
            "title": "Incursiones en Aucayacu",
            "place": "Aucayacu, Leoncio Prado, <b>Huánuco</b>",
            "desc": "Incursiones armadas contra el puesto policial y campaña de violencia en el Alto Huallaga con <b>asesinatos selectivos</b> de autoridades y comuneros opuestos a la organización."
          },
          "9": {

            "date": "16 de julio, 1984",
            "cat": "Masacre",
            "title": "Masacre de Soras",
            "place": "Soras, Sucre, <b>Ayacucho</b>",
            "desc": "Una sanguinaria columna de Sendero Luminoso interceptó un convoy de autobuses ('el expreso de la muerte') entre Soras y Ayacucho. Asesinaron cruelmente a <b>117 campesinos</b>, incluyendo mujeres, ancianos y niños, como represalia por defender sus comunidades."
          },
          "10": {
            "date": "16 de agosto, 1985",
            "cat": "Atentado",
            "title": "Atentado en La Curva del Diablo",
            "place": "Villa María del Triunfo y Tablada de Lurín, <b>Lima</b>",
            "desc": "Miembros de Sendero Luminoso atacaron a personal naval que se disponía a abordar buses hacia la Base Naval del Callao. En la emboscada <b>fallecieron tres valerosos marinos</b>."
          },
          "11": {

            "date": "29 de agosto, 1985",
            "cat": "Ataque",
            "title": "Ataque a Vilcashuamán",
            "place": "Vilcashuamán, <b>Ayacucho</b>",
            "desc": "Destrucción con dinamita del puesto de la Guardia Civil y la sede municipal, resultando en <b>6 policías</b> y varios civiles muertos."
          },
          "12": {

            "date": "4 de mayo, 1986",
            "cat": "Asesinato",
            "title": "Asesinato del contralmirante Carlos Ponce Canessa",
            "place": "San Isidro, <b>Lima</b>",
            "desc": "Un comando de aniquilamiento de Sendero Luminoso acribilló en San Isidro al contralmirante AP Carlos Ponce Canessa, miembro del Estado Mayor de la Marina de Guerra del Perú, cuando se desplazaba en su vehículo sin escolta."
          },
          "13": {

            "date": "14 de octubre, 1986",
            "cat": "Atentado",
            "title": "Atentado contra el vicealmirante Gerónimo Cafferata",
            "place": "San Isidro, <b>Lima</b>",
            "desc": "Atentado senderista en Lima contra el vicealmirante AP (r) Gerónimo Cafferata Marazzi, ex comandante general de la Marina de Guerra y presidente del Banco Industrial. Trasladado de urgencia a EE.UU., falleció a causa de las graves heridas el 18 de octubre."
          },
          "14": {

            "date": "17 de febrero, 1987",
            "cat": "Masacre",
            "title": "Masacre de Cochas",
            "place": "Cochas, <b>Ayacucho</b>",
            "desc": "Ocurrió el 17 de febrero de 1987 en la comunidad de Cochas, Ayacucho. Una columna armada de Sendero Luminoso asaltó la localidad violentamente, obligando a los pobladores a concentrarse en la plaza principal y abriendo fuego indiscriminado contra la multitud, dejando un saldo de <b>30 pobladores muertos</b> como represalia por resistirse a la ideología senderista y defender su territorio."
          },
          "15": {

            "date": "Año 1987",
            "cat": "Sabotaje",
            "title": "Ataques a SAIS Cahuide y Pachacútec",
            "place": "Jauja y Huancayo, <b>Junín</b>",
            "desc": "Ataques sistemáticos contra cooperativas agrarias SAIS Cahuide y Pachacútec; <b>asesinato del administrador</b>, destrucción de maquinaria, saqueo e incendio de instalaciones."
          },
          "16": {

            "date": "18 de octubre, 1987",
            "cat": "Ataque",
            "title": "Ataque del MRTA a Soritor",
            "place": "Soritor, Moyobamba, <b>San Martín</b>",
