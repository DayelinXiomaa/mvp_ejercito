        modal_desc_label: "HISTORICAL ACCOUNT AND DETAIL OF THE ACTION:",
        modal_close_btn: "CLOSE",
        events: {
          "1": {

            "date": "May 17, 1980",
            "cat": "Attack",
            "title": "Chuschi Attack",
            "place": "Cangallo, <b>Ayacucho</b>",
            "desc": "Burning of ballot boxes and electoral records by Sendero Luminoso. <b>Marked the start of terrorist violence</b> in Peru."
          },
          "2": {

            "date": "Late September, 1981",
            "cat": "Bombing",
            "title": "Explosives Attack on the Congress of the Republic",
            "place": "Lima, <b>Lima</b>",
            "desc": "A bomb blast severely damaged a balcony of the Congress of the Republic. The incident triggered an intense national debate regarding police readiness against the emerging terrorist threat."
          },
          "3": {

            "date": "October 11, 1981",
            "cat": "Attack",
            "title": "Attack on the Tambo Police Outpost",
            "place": "Tambo, La Mar, <b>Ayacucho</b>",
            "desc": "Sendero Luminoso militants carried out an armed raid on the Tambo police post. A Civil Guard officer and two civilians were killed, leading the government to declare a state of emergency across five provinces in Ayacucho."
          },
          "4": {

            "date": "July 5, 1982",
            "cat": "Attack",
            "title": "Attack on Ñaña Police Post",
            "place": "Ñaña, <b>Lima</b>",
            "desc": "Night assault by Sendero Luminoso to seize weapons and ammunition. Officers <b>Luis Muñoz</b> and <b>Luis Navarrete</b> were killed; heroic resistance prevented the post from being captured."
          },
          "5": {

            "date": "October 6, 1982",
            "cat": "Attack",
            "title": "Attack on Mayocc Outpost",
            "place": "Mayocc, <b>Huancavelica</b> and Huanta",
            "desc": "Clash between Sendero Luminoso and Civil Guard leaving <b>4 police dead</b> and 3 wounded. In Huanta, 18 dynamite bombings were staged as diversions."
          },
          "6": {

            "date": "1982–1984",
            "cat": "Massacre",
            "title": "Violence in Chungui and Oreja de Perro",
            "place": "Chungui and Oreja de Perro, <b>Ayacucho</b>",
            "desc": "Systematic Sendero Luminoso terror against rural communities: <b>mass executions</b>, kidnappings, disappearances, looting, and forced peasant displacement."
          },
          "7": {

            "date": "April 3, 1983",
            "cat": "Massacre",
            "title": "Lucanamarca Massacre",
            "place": "Huanca Sancos, <b>Ayacucho</b>",
            "desc": "Slaughter of <b>69 peasants</b> with axes, machetes, and firearms by direct command of Abimael Guzmán."
          },
          "8": {

            "date": "January and July, 1984",
            "cat": "Incursion",
            "title": "Incursions into Aucayacu",
            "place": "Aucayacu, Leoncio Prado, <b>Huánuco</b>",
            "desc": "Armed raids against the police station and terror campaign in the Alto Huallaga, including <b>targeted murders</b> of local authorities and opposed villagers."
          },
          "9": {

            "date": "July 16, 1984",
            "cat": "Massacre",
            "title": "Soras Massacre",
            "place": "Soras, Sucre, <b>Ayacucho</b>",
            "desc": "Sendero Luminoso militants intercepted a bus convoy known as the 'Death Express' between Soras and Ayacucho. They brutally murdered <b>117 villagers</b>, including women, elders, and children, in retaliation for the community's resistance."
          },
          "10": {
            "date": "August 16, 1985",
            "cat": "Attack",
            "title": "Attack at Devil's Curve (La Curva del Diablo)",
            "place": "Villa Maria del Triunfo & Tablada de Lurin, <b>Lima</b>",
            "desc": "Shining Path terrorists ambushed naval personnel boarding buses to the Callao Naval Base. The criminal assault killed <b>three brave Peruvian Navy sailors</b>."
          },
          "11": {

            "date": "August 29, 1985",
            "cat": "Attack",
            "title": "Attack on Vilcashuamán",
            "place": "Vilcashuamán, <b>Ayacucho</b>",
            "desc": "Dynamite blast against the Civil Guard outpost and town hall, leaving <b>6 police officers</b> and several civilians dead."
          },
          "12": {

            "date": "May 4, 1986",
            "cat": "Assassination",
            "title": "Assassination of Rear Admiral Carlos Ponce Canessa",
            "place": "San Isidro, <b>Lima</b>",
            "desc": "A Sendero Luminoso hit squad ambushed and assassinated Rear Admiral AP Carlos Ponce Canessa, member of the General Staff of the Peruvian Navy, while driving in San Isidro."
          },
          "13": {

            "date": "October 14, 1986",
            "cat": "Attack",
            "title": "Attack on Vice Admiral Gerónimo Cafferata Marazzi",
            "place": "San Isidro, <b>Lima</b>",
            "desc": "Sendero Luminoso targeted Vice Admiral AP (r) Gerónimo Cafferata Marazzi, former Commander General of the Navy and head of the Industrial Bank. Evacuated to the United States, he succumbed to severe injuries on October 18."
          },
          "14": {

            "date": "February 17, 1987",
            "cat": "Massacre",
            "title": "Cochas Massacre",
            "place": "Cochas, <b>Ayacucho</b>",
            "desc": "Occurred on February 17, 1987, in the community of Cochas, Ayacucho. An armed Sendero Luminoso column violently raided the town, forcing residents into the main square and opening fire indiscriminately on the crowd, leaving <b>30 villagers dead</b> as punishment for resisting senderista ideology and defending their territory."
          },
