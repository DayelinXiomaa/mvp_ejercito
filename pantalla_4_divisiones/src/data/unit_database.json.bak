  "compaapolicamilitarn7": {
    "nombre": "COMPAÑÍA POLICÍA MILITAR N° 7",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA POLICÍA MILITAR N° 7",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Policía Militar, fue organizada para proporcionar apoyo de Policía Militar al Comando de la 7ª Brigada de Infantería. Su misión principal es mantener el orden, la disciplina y la seguridad en las instalaciones militares pertenecientes a la brigada. Cumple tareas de control de accesos, custodia de la Comandancia y residencias militares, regulación del tránsito y protección de autoridades. En el ámbito operativo participa en patrullajes, puntos de control y medidas de seguridad destinadas a proteger al personal y los puestos de comando.\n\nTiene su sede en la guarnición de Lambayeque.",
    "escudo": "/assets/divisiones/slide_54_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 7",
        "resena": "La Compañía Policía Militar, fue organizada para proporcionar apoyo de Policía Militar al Comando de la 7ª Brigada de Infantería. Su misión principal es mantener el orden, la disciplina y la seguridad en las instalaciones militares pertenecientes a la brigada. Cumple tareas de control de accesos, custodia de la Comandancia y residencias militares, regulación del tránsito y protección de autoridades. En el ámbito operativo participa en patrullajes, puntos de control y medidas de seguridad destinadas a proteger al personal y los puestos de comando.\n\nTiene su sede en la guarnición de Lambayeque."
      },
      "en": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 7",
        "resena": "The Compañía Policía Militar was organized to provide military police support to the Command of the 7ª Brigada de Infantería. Its primary mission is to maintain order, discipline, and security in the military facilities belonging to the brigade. It performs access-control duties, guards the Command headquarters and military residences, regulates traffic, and protects authorities. In the operational sphere, it participates in patrols, checkpoints, and security measures intended to protect personnel and command posts. Its headquarters is located in the Lambayeque garrison."
      },
      "qu": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 7",
        "resena": "Compañía Policía Militar nisqaqa 7ª Brigada de Infanteríapa Comando-ninman Policía Militar yanapayta qunanpaq wakichisqa karqan. Hatun misión-ninmi brigadapa instalaciones militares nisqapi orden, disciplina hinallataq seguridadta waqaychay. Yaykunakuna controlay, Comandanciawan residencias militares qhawapay, tránsito kamachiy hinallataq autoridades waqaychay ruraykunata hunt'an. Operacionespi patrullajes, puntos de control hinallataq personalwan puestos de comandota amachaq medidas de seguridad nisqakunapi yanapan. Sede-ninmi guarnición de Lambayeque nisqapi kachkan."
      }
    }
  },
