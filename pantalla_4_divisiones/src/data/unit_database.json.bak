  "idivisindeejercito": {
    "nombre": "I DIVISIÓN DE EJERCITO",
    "tipo": "Unidad Orgánica",
    "alias": "I DIVISIÓN DE EJERCITO",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "1ª  BRIGADA DE\n\nSELVA DE PROT\n\nDE LA AMAZONÍA\n\n1ª  BRIGADA DE\n\nINFANTERIA\n\n1ª BRIGADA DE\n\nCABALLERÍA\n\n7ª BRIGADA DE\n\nINFANTERÍA\n\n1ª  BRIGADA DE\n\nSERVICIOS\n\n9ª BRIGADA\n\nBLINDADA\n\n32ª  BRIGADA DE\n\nINFANTERIA\n\nAGRUPAMIENTO\n\nDE ARTILLERÍA\n\nBATALLÓN DE\n\nCOMUNICACIONES\n\nN° 111\n\nCOMPAÑÍA\n\nCOMANDO\n\nN° 111\n\nCOMPAÑÍA DE\n\nING ANFIBIA\n\nN° 111\n\nBATALLÓN\n\nPOLICIA MILITAR\n\nN° 111",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
