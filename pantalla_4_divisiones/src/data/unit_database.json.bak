  "compaapolicamilitarn6": {
    "nombre": "COMPAÑÍA POLICÍA MILITAR N° 6",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA POLICÍA MILITAR N° 6",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía de Policía Militar Nº 6 es una pequeña unidad orgánica y directamente dependiente de la 6ª Brigada Blindada. Fue organizada para mantener la disciplina, el orden y la seguridad en las instalaciones y áreas bajo responsabilidad de la Brigada.\n\nSu misión comprende el control de accesos, protección de autoridades, custodia de instalaciones y regulación del tránsito militar. Tiene su sede en Locumba, región Tacna, y garantiza el orden necesario para el cumplimiento de la misión de la 6ª Brigada Blindada.",
    "escudo": "/assets/divisiones/slide_331_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 6",
        "resena": "La Compañía de Policía Militar Nº 6 es una pequeña unidad orgánica y directamente dependiente de la 6ª Brigada Blindada. Fue organizada para mantener la disciplina, el orden y la seguridad en las instalaciones y áreas bajo responsabilidad de la Brigada.\n\nSu misión comprende el control de accesos, protección de autoridades, custodia de instalaciones y regulación del tránsito militar. Tiene su sede en Locumba, región Tacna, y garantiza el orden necesario para el cumplimiento de la misión de la 6ª Brigada Blindada."
      },
      "en": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 6",
        "resena": "The Compañía de Policía Militar Nº 6 is a small organic unit directly subordinate to the 6ª Brigada Blindada. It was organized to maintain discipline, order, and security in the facilities and areas under the Brigade’s responsibility. Its mission includes access control, protection of authorities, security of facilities, and regulation of military traffic. Its headquarters are in Locumba, región Tacna, and it ensures the order required for the 6ª Brigada Blindada to accomplish its mission."
      },
      "qu": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 6",
        "resena": "Compañía de Policía Militar Nº 6qa 6ª Brigada Blindada-man chiqanmanta kamachisqa pequeña unidad orgánican. Brigada-pa instalaciones chaymanta responsabilidad kitikunapi disciplina, orden y seguridad waqaychananpaq wakichisqa karqan. Misiónninmi yaykuykunata controlay, autoridades waqaychay, instalaciones qhawapay chaymanta tránsito militar kamachiy. Kamachina wasinqa Locumba, Tacna regiónpin kachkan; 6ª Brigada Blindada-pa misiónnin hunt'ananpaq orden waqaychan."
      }
