  "batallndeselvacoronelalfonsougarten47": {
    "nombre": "BATALLÓN DE SELVA “CORONEL ALFONSO UGARTE” N° 47",
    "tipo": "Unidad Orgánica",
    "alias": "BATALLÓN DE SELVA “CORONEL ALFONSO UGARTE” N° 47",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Fue creado el 17 de noviembre de 1943, mediante Resolución Suprema Nº 4/EMGE, y organizado inicialmente en la ciudad de Iquitos. En septiembre de 1949 recibió el nombre de “Alfonso Ugarte”, en homenaje al héroe peruano de las batallas de Tarapacá y Arica. Desde 1955 asumió la vigilancia del sector Morona-Pastaza, resguardando una extensa zona de la frontera nororiental. Participó en las operaciones de la Cordillera del Cóndor de 1981 y en el Conflicto del Cenepa de 1995.\n\nSu sede se encuentra en la guarnición de Sargento Puño, distrito de Morona, provincia de Datem del Marañón, región Loreto.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATALLÓN DE SELVA “CORONEL ALFONSO UGARTE” N° 47",
        "resena": "Fue creado el 17 de noviembre de 1943, mediante Resolución Suprema Nº 4/EMGE, y organizado inicialmente en la ciudad de Iquitos. En septiembre de 1949 recibió el nombre de “Alfonso Ugarte”, en homenaje al héroe peruano de las batallas de Tarapacá y Arica. Desde 1955 asumió la vigilancia del sector Morona-Pastaza, resguardando una extensa zona de la frontera nororiental. Participó en las operaciones de la Cordillera del Cóndor de 1981 y en el Conflicto del Cenepa de 1995.\n\nSu sede se encuentra en la guarnición de Sargento Puño, distrito de Morona, provincia de Datem del Marañón, región Loreto."
      },
      "en": {
        "nombre": "BATALLÓN DE SELVA “CORONEL ALFONSO UGARTE” N° 47",
        "resena": "It was created on November 17, 1943, by Resolución Suprema Nº 4/EMGE, and was initially organized in the city of Iquitos. In September 1949, it received the name “Alfonso Ugarte”, in tribute to the Peruvian hero of the batallas de Tarapacá y Arica. Beginning in 1955, it assumed surveillance of the Morona-Pastaza sector, protecting an extensive area of the northeastern border. It participated in the operaciones de la Cordillera del Cóndor of 1981 and the Conflicto del Cenepa of 1995. Its headquarters are in guarnición de Sargento Puño, distrito de Morona, provincia de Datem del Marañón, región Loreto."
      },
      "qu": {
        "nombre": "BATALLÓN DE SELVA “CORONEL ALFONSO UGARTE” N° 47",
        "resena": "17 de noviembre de 1943 p'unchawmi Resolución Suprema Nº 4/EMGE kamachiywan paqarichisqa, Iquitos llaqtapi kamarisqa karqan. Septiembre de 1949 killapi batallas de Tarapacá y Arica qhari Alfonso Ugarte yupaychayninpaq sutinta chaskirqan. 1955 watamanta Morona-Pastaza sectorta qhawarqan, nororiente fronterapa hatun allpanta waqaychaspa. Operaciones de la Cordillera del Cóndor de 1981 hinallataq Conflicto del Cenepa de 1995 nisqakunapi yanaparqan. Sedenmi Sargento Puño guarnición, Morona distrito, Datem del Marañón provincia, Loreto suyupi kachkan."
      }
    }
  },
