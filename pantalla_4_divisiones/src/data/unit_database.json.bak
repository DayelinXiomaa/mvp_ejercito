  "grupodeartilleradecampaacrljsjuaquninclann4": {
    "nombre": "GRUPO DE ARTILLERÍA DE CAMPAÑA “ CRL JÓSÉ JUAQUÍN INCLAN” N° 4",
    "tipo": "Unidad Orgánica",
    "alias": "GRUPO DE ARTILLERÍA DE CAMPAÑA “ CRL JÓSÉ JUAQUÍN INCLAN” N° 4",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Fue creado mediante Decreto Supremo del 20 de septiembre de 1919, inicialmente con la denominación de Regimiento de Artillería de Montaña Nº 4. Su primera guarnición fue la ciudad del Cusco, donde permaneció hasta 1927, trasladándose posteriormente por Juliaca, Ilave y nuevamente el Cusco. El 10 de agosto de 1936 retornó a Juliaca y ocupó el cuartel “Francisco Bolognesi”, construido especialmente para alojar a la unidad. El 10 de octubre de 1936 cambió su categoría de regimiento a Grupo de Artillería, conservando su número y organización operacional. Lleva el nombre del coronel José Joaquín Inclán, jefe de las baterías del sector norte del Callao durante el combate del 2 de Mayo de 1866. Mantiene su sede en el cuartel “Francisco Bolognesi” de Juliaca, provincia de San Román, región Puno.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "GRUPO DE ARTILLERÍA DE CAMPAÑA “ CRL JÓSÉ JUAQUÍN INCLAN” N° 4",
        "resena": "Fue creado mediante Decreto Supremo del 20 de septiembre de 1919, inicialmente con la denominación de Regimiento de Artillería de Montaña Nº 4. Su primera guarnición fue la ciudad del Cusco, donde permaneció hasta 1927, trasladándose posteriormente por Juliaca, Ilave y nuevamente el Cusco. El 10 de agosto de 1936 retornó a Juliaca y ocupó el cuartel “Francisco Bolognesi”, construido especialmente para alojar a la unidad. El 10 de octubre de 1936 cambió su categoría de regimiento a Grupo de Artillería, conservando su número y organización operacional. Lleva el nombre del coronel José Joaquín Inclán, jefe de las baterías del sector norte del Callao durante el combate del 2 de Mayo de 1866. Mantiene su sede en el cuartel “Francisco Bolognesi” de Juliaca, provincia de San Román, región Puno."
      },
      "en": {
        "nombre": "GRUPO DE ARTILLERÍA DE CAMPAÑA “ CRL JÓSÉ JUAQUÍN INCLAN” N° 4",
        "resena": "It was created by Decreto Supremo of September 20, 1919, initially under the designation Regimiento de Artillería de Montaña Nº 4. Its first garrison was ciudad del Cusco, where it remained until 1927 before subsequently moving through Juliaca, Ilave, and Cusco again. On August 10, 1936, it returned to Juliaca and occupied cuartel “Francisco Bolognesi”, built specifically to house the unit. On October 10, 1936, its category changed from regiment to Grupo de Artillería, retaining its number and operational organization. It bears the name of coronel José Joaquín Inclán, commander of the batteries in the northern sector of Callao during the combate del 2 de Mayo de 1866. Its headquarters remain at cuartel “Francisco Bolognesi” in Juliaca, provincia de San Román, región Puno."
      },
      "qu": {
        "nombre": "GRUPO DE ARTILLERÍA DE CAMPAÑA “ CRL JÓSÉ JUAQUÍN INCLAN” N° 4",
        "resena": "Decreto Supremo, 20 septiembre 1919 kamachiywanmi Regimiento de Artillería de Montaña Nº 4 sutiwan kamasqa karqan. Ñawpaq guarniciónninqa Cusco llaqta karqan; 1927 watakama chaypi qhiparqan, qhipaman Juliaca, Ilave chaymanta wakmanta Cusco kitikunaman apasqa. 10 agosto 1936 p'unchaw Juliaca-man kutirqan, unidadpaq ruwasqa cuartel “Francisco Bolognesi” nisqapi tiyaspa. 10 octubre 1936 p'unchaw regimiento-manta Grupo de Artillería categoría-man tukurqan, numeralninta chaymanta operaciones wakichiyninta waqaychaspa. Coronel José Joaquín Inclán-pa sutintan apan; payqa combate del 2 de Mayo de 1866 ukhupi Callao norte sector baterías kamachiq karqan. Kamachina wasinqa cuartel “Francisco Bolognesi”, Juliaca, San Román provincia, Puno regiónpin kachkan."
      }
    }
  },
