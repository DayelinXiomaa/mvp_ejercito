  "compaacomandoyserviciosn113": {
    "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 113",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA COMANDO Y SERVICIOS N° 113",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Comando y Servicios Nº 113 es una pequeña unidad orgánica de la 3ª Brigada de Servicios de la III División de Ejército. Fue organizada para apoyar al comandante y Estado Mayor, asegurando el funcionamiento permanente del puesto de comando de la Brigada. Proporciona personal auxiliar, seguridad, transporte, abastecimiento inmediato y otros servicios administrativos requeridos por el comando. Asimismo, atiende el mantenimiento de las instalaciones, los servicios internos y el apoyo general durante ejercicios y operaciones logísticas.\n\nTiene su sede en el Fuerte Mariano Bustamante, distrito de Mariano Melgar, Arequipa",
    "escudo": "/assets/divisiones/slide_516_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 113",
        "resena": "La Compañía Comando y Servicios Nº 113 es una pequeña unidad orgánica de la 3ª Brigada de Servicios de la III División de Ejército. Fue organizada para apoyar al comandante y Estado Mayor, asegurando el funcionamiento permanente del puesto de comando de la Brigada. Proporciona personal auxiliar, seguridad, transporte, abastecimiento inmediato y otros servicios administrativos requeridos por el comando. Asimismo, atiende el mantenimiento de las instalaciones, los servicios internos y el apoyo general durante ejercicios y operaciones logísticas.\n\nTiene su sede en el Fuerte Mariano Bustamante, distrito de Mariano Melgar, Arequipa"
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 113",
        "resena": "The Compañía Comando y Servicios Nº 113 is a small organic unit of the 3ª Brigada de Servicios of the III División de Ejército. It was organized to support the commander and Staff, ensuring the continuous operation of the Brigade command post. It provides auxiliary personnel, security, transportation, immediate supply, and other administrative services required by the command. It also handles facility maintenance, internal services, and general support during exercises and logistical operations. Its headquarters are at Fuerte Mariano Bustamante, distrito de Mariano Melgar, Arequipa."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 113",
        "resena": "Compañía Comando y Servicios Nº 113qa III División de Ejército-pa 3ª Brigada de Servicios nisqanmanta huch'uy unidad orgánican. Brigada-pa comandante chaymanta Estado Mayor-ninta yanapanapaq, puesto de comando mana p'akisqa llamk'ananpaqmi wakichisqa karqan. Comando munasqan runakuna, seguridad, transporte, utqay abastecimiento chaymanta wak administración servicios nisqakunata qun. Hinallataq instalaciones mantenimiento, servicios internos chaymanta ejercicios y operaciones logísticas ukhupi general yanapayta ruwan. Kamachina wasinqa Fuerte Mariano Bustamante, Mariano Melgar distrito, Arequipa llaqtapin kachkan."
      }
    }
  },
