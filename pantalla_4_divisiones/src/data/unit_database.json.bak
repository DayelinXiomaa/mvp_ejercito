  "compaacomandon5": {
    "nombre": "COMPAÑÍA COMANDO N° 5",
    "escudo": "/assets/divisiones/slide_348_img_1.png",
    "resena": "es Cia Cmdo N° 114, la Compañía Comando «Salkantay» Nº 5 es una pequeña unidad orgánica y directamente dependiente de la 5ª Brigada de Montaña. Fue organizada para proporcionar seguridad, apoyo administrativo y facilidades de funcionamiento al Comando y Estado Mayor de la Brigada. Su misión comprende instalar y proteger el puesto de comando, atender el servicio interno y apoyar las actividades de comando y control. Asimismo, participa en ejercicios de campaña, ceremonias militares, desplazamientos y acciones de apoyo a la población. Tiene su sede en Cusco.",
    "page": 348,
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO N° 5",
        "resena": "es Cia Cmdo N° 114, la Compañía Comando «Salkantay» Nº 5 es una pequeña unidad orgánica y directamente dependiente de la 5ª Brigada de Montaña. Fue organizada para proporcionar seguridad, apoyo administrativo y facilidades de funcionamiento al Comando y Estado Mayor de la Brigada. Su misión comprende instalar y proteger el puesto de comando, atender el servicio interno y apoyar las actividades de comando y control. Asimismo, participa en ejercicios de campaña, ceremonias militares, desplazamientos y acciones de apoyo a la población. Tiene su sede en Cusco."
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO N° 5",
        "resena": "the Compañía Comando «Salkantay» Nº 5 is a small organic unit directly subordinate to the 5ª Brigada de Montaña. It was organized to provide security, administrative support, and operational facilities for the Brigade Command and Staff. Its mission includes establishing and protecting the command post, providing internal services, and supporting command-and-control activities. It also participates in field exercises, military ceremonies, movements, and actions in support of the population. Its headquarters are in Cusco."
      },
