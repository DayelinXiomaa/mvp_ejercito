  "compaadeinteligenciacapeprobertsonsotoruizn114": {
    "nombre": "COMPAÑÍA DE INTELIGENCIA “ CAP EP ROBERTSON SOTO RUIZ” N° 114",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA DE INTELIGENCIA “ CAP EP ROBERTSON SOTO RUIZ” N° 114",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía de Inteligencia Nº 114 integra el dispositivo operacional del Comando Especial VRAEM, fue organizada para proporcionar inteligencia oportuna al planeamiento y conducción de las operaciones militares. Ha participado en acciones contra remanentes terroristas y organizaciones vinculadas al tráfico ilícito de drogas. Su labor contribuye a identificar amenazas, proteger a las fuerzas y brindar seguridad a la población del VRAEM. Asimismo, apoya el cumplimiento de la misión de la IV División de Ejército dentro de esta zona estratégica.\n\nSu sede se encuentra en el Fuerte Pichari, distrito de Pichari, provincia de La Convención, región Cusco.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA DE INTELIGENCIA “ CAP EP ROBERTSON SOTO RUIZ” N° 114",
        "resena": "La Compañía de Inteligencia Nº 114 integra el dispositivo operacional del Comando Especial VRAEM, fue organizada para proporcionar inteligencia oportuna al planeamiento y conducción de las operaciones militares. Ha participado en acciones contra remanentes terroristas y organizaciones vinculadas al tráfico ilícito de drogas. Su labor contribuye a identificar amenazas, proteger a las fuerzas y brindar seguridad a la población del VRAEM. Asimismo, apoya el cumplimiento de la misión de la IV División de Ejército dentro de esta zona estratégica.\n\nSu sede se encuentra en el Fuerte Pichari, distrito de Pichari, provincia de La Convención, región Cusco."
      },
      "en": {
        "nombre": "COMPAÑÍA DE INTELIGENCIA “ CAP EP ROBERTSON SOTO RUIZ” N° 114",
        "resena": "The Compañía de Inteligencia Nº 114 forms part of the operational organization of the Comando Especial VRAEM and was organized to provide timely intelligence for the planning and conduct of military operations. It has participated in actions against terrorist remnants and organizations linked to illicit drug trafficking. Its work helps identify threats, protect forces, and provide security to the population of the VRAEM. It also supports the accomplishment of the IV División de Ejército's mission within this strategic zone. Its headquarters are at Fuerte Pichari, distrito de Pichari, provincia de La Convención, región Cusco."
      },
      "qu": {
        "nombre": "COMPAÑÍA DE INTELIGENCIA “ CAP EP ROBERTSON SOTO RUIZ” N° 114",
        "resena": "Compañía de Inteligencia Nº 114qa Comando Especial VRAEM-pa dispositivo operacional-ninman hukuchasqa; operaciones militares planificay chaymanta purichinapaq pacha chayaq inteligencia qunanpaq wakichisqa karqan. Terrorista puchukaykuna chaymanta tráfico ilícito de drogas-wan tupaq organizaciones contra ruwaykunapi yanaparqan. Llamk'ayninmi amenazas riqsiyta, fuerzakuna waqaychayta chaymanta VRAEM llaqtakunaman seguridad quyta kallpachan. Hinallataq kay estratégica zona ukhupi IV División de Ejército-pa misiónninta yanapan. Kamachina wasinqa Fuerte Pichari, Pichari distrito, La Convención provincia, Cusco regiónpin kachkan."
      }
    }
  },
