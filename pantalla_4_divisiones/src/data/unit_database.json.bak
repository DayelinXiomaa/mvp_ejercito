  "compaacomunicacionesn31": {
    "nombre": "COMPAÑÍA COMUNICACIONES N° 31",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA COMUNICACIONES N° 31",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía de Comunicaciones Nº 31 es una pequeña unidad orgánica de la 31ª Brigada de Infantería. Fue organizada para proporcionar apoyo de comunicaciones al comando y facilitar la conducción de las operaciones militares de la Gran Unidad. Instala, opera y mantiene los sistemas de radio, telefonía, transmisión de datos y demás medios empleados en los puestos de comando. Ha apoyado las operaciones contraterroristas desarrolladas en la sierra central y el VRAEM, garantizando enlaces seguros y permanentes.\n\nSu sede se encuentra en el Cuartel “9 de Diciembre”, distrito de Chilca, provincia de Huancayo, región Junín.",
    "escudo": "/assets/divisiones/slide_546_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMUNICACIONES N° 31",
        "resena": "La Compañía de Comunicaciones Nº 31 es una pequeña unidad orgánica de la 31ª Brigada de Infantería. Fue organizada para proporcionar apoyo de comunicaciones al comando y facilitar la conducción de las operaciones militares de la Gran Unidad. Instala, opera y mantiene los sistemas de radio, telefonía, transmisión de datos y demás medios empleados en los puestos de comando. Ha apoyado las operaciones contraterroristas desarrolladas en la sierra central y el VRAEM, garantizando enlaces seguros y permanentes.\n\nSu sede se encuentra en el Cuartel “9 de Diciembre”, distrito de Chilca, provincia de Huancayo, región Junín."
      },
      "en": {
        "nombre": "COMPAÑÍA COMUNICACIONES N° 31",
        "resena": "The Compañía de Comunicaciones Nº 31 is a small organic unit of the 31ª Brigada de Infantería. It was organized to provide communications support to the command and facilitate the conduct of the Gran Unidad's military operations. It installs, operates, and maintains radio, telephone, data transmission, and other systems used at command posts. It has supported counterterrorism operations conducted in the central highlands and the VRAEM, ensuring secure and continuous communications. Its headquarters are at Cuartel “9 de Diciembre”, distrito de Chilca, provincia de Huancayo, región Junín."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMUNICACIONES N° 31",
        "resena": "Compañía de Comunicaciones Nº 31qa 31ª Brigada de Infantería-pa pequeña unidad orgánican. Comando-man comunicaciones yanapay qunanpaq chaymanta Gran Unidad-pa operaciones-ninta purichiyta facilitananpaq wakichisqa karqan. Puestos de comando nisqapi radio, telefonía, transmisión de datos chaymanta wak medios sistemas nisqakunata churan, llamk'achin chaymanta allichan. Sierra central chaymanta VRAEM nisqapi operaciones contraterroristas yanaparqan, seguro y permanente enlaces waqaychaspa. Kamachina wasinqa Cuartel “9 de Diciembre”, Chilca distrito, Huancayo provincia, Junín regiónpin kachkan."
      }
    }
  },
