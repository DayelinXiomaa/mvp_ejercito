  "unidadmilitardeasentamientoruralangamosn2": {
    "nombre": "UNIDAD MILITAR DE ASENTAMIENTO RURAL “ANGAMOS” N° 2",
    "tipo": "Unidad Orgánica",
    "alias": "UNIDAD MILITAR DE ASENTAMIENTO RURAL “ANGAMOS” N° 2",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Unidad Militar de Asentamiento Rural Nº 2 fue establecida para consolidar la presencia del Estado y promover el desarrollo de la frontera amazónica. Tiene presencia activa en Colonia Angamos, por lo menos, desde 1996.\n\nSu misión comprende la vigilancia fronteriza, el apoyo al poblamiento rural y la protección de la soberanía frente a actividades ilícitas transfronterizas. Asimismo, impulsa proyectos productivos, capacitación técnica y jornadas educativas, sanitarias, sociales y ambientales en favor de las comunidades locales.\n\nSu sede se encuentra en Colonia Angamos, distrito de Yaquerana, provincia de Requena, región Loreto, en la frontera con Brasil.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "UNIDAD MILITAR DE ASENTAMIENTO RURAL “ANGAMOS” N° 2",
        "resena": "La Unidad Militar de Asentamiento Rural Nº 2 fue establecida para consolidar la presencia del Estado y promover el desarrollo de la frontera amazónica. Tiene presencia activa en Colonia Angamos, por lo menos, desde 1996.\n\nSu misión comprende la vigilancia fronteriza, el apoyo al poblamiento rural y la protección de la soberanía frente a actividades ilícitas transfronterizas. Asimismo, impulsa proyectos productivos, capacitación técnica y jornadas educativas, sanitarias, sociales y ambientales en favor de las comunidades locales.\n\nSu sede se encuentra en Colonia Angamos, distrito de Yaquerana, provincia de Requena, región Loreto, en la frontera con Brasil."
      },
      "en": {
        "nombre": "UNIDAD MILITAR DE ASENTAMIENTO RURAL “ANGAMOS” N° 2",
        "resena": "The Unidad Militar de Asentamiento Rural Nº 2 was established to consolidate the State's presence and promote development along the Amazonian border. It has maintained an active presence in Colonia Angamos since at least 1996. Its mission includes border surveillance, support for rural settlement, and protection of sovereignty against illicit cross-border activities. It also promotes productive projects, technical training, and educational, medical, social, and environmental activities for local communities. Its headquarters are in Colonia Angamos, distrito de Yaquerana, provincia de Requena, región Loreto, on the border with Brasil."
      },
      "qu": {
        "nombre": "UNIDAD MILITAR DE ASENTAMIENTO RURAL “ANGAMOS” N° 2",
        "resena": "Unidad Militar de Asentamiento Rural Nº 2qa Estadopa kayninta kallpachananpaq, Amazonía fronterapa wiñariyninta yanapananpaq kamarisqa karqan. 1996 watamantaraq Colonia Angamos-pi llamk'achkan. Misiónninmi fronterata qhaway, chakrapi runakuna tiyayta yanapay, frontera chimpapi mana allin ruraykunamanta soberaniata amachay. Chaynallataq producción proyectos, técnica yachachiy, educación, sanidad, sociedad hinallataq medio ambiente llamk'aykunata llaqtarunakuna allinninpaq ruwan. Sedenmi Colonia Angamos, Yaquerana distrito, Requena provincia, Loreto suyupi, Brasil fronterapi kachkan."
      }
    }
  },
