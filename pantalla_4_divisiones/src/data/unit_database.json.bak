  "compaacomandon4": {
    "nombre": "COMPAÑÍA COMANDO N° 4",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA COMANDO N° 4",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Comando Nº 4 es una pequeña unidad orgánica y directamente dependiente del Cuartel General de la 4ª Brigada de Montaña. Fue organizada para proporcionar seguridad, apoyo administrativo y facilidades de funcionamiento al Comando y Estado Mayor de la Brigada.\n\nSu misión comprende instalar y proteger el puesto de comando, atender el servicio interno y apoyar las actividades de comando y control. Tiene su sede en el Cuartel Inca Manco Cápac de Puno.",
    "escudo": "/assets/divisiones/slide_381_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO N° 4",
        "resena": "La Compañía Comando Nº 4 es una pequeña unidad orgánica y directamente dependiente del Cuartel General de la 4ª Brigada de Montaña. Fue organizada para proporcionar seguridad, apoyo administrativo y facilidades de funcionamiento al Comando y Estado Mayor de la Brigada.\n\nSu misión comprende instalar y proteger el puesto de comando, atender el servicio interno y apoyar las actividades de comando y control. Tiene su sede en el Cuartel Inca Manco Cápac de Puno."
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO N° 4",
        "resena": "The Compañía Comando Nº 4 is a small organic unit directly subordinate to the Cuartel General of the 4ª Brigada de Montaña. It was organized to provide security, administrative support, and operational facilities for the Brigade Command and Staff. Its mission includes establishing and protecting the command post, providing internal services, and supporting command-and-control activities. Its headquarters are at Cuartel Inca Manco Cápac in Puno."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO N° 4",
        "resena": "Compañía Comando Nº 4qa Cuartel General de la 4ª Brigada de Montaña-manta chiqalla kamachisqa huch'uy unidad orgánican. Brigada-pa Comando chaymanta Estado Mayor-ninman seguridad, administración yanapay hinaspa llamk'ananpaq facilidades quyta ruwanapaqmi wakichisqa karqan. Misiónninmi puesto de comando churay hinaspa amachay, servicio interno qhawariy chaymanta comando y control ruraykunata yanapay. Kamachina wasinqa Cuartel Inca Manco Cápac, Puno llaqtapin kachkan."
      }
    }
  },
