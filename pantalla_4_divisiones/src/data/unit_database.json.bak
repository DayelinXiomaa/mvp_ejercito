  "COMPAÑÍA COMANDO Y SERVICIOS N° 33": {
    "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 33",
    "escudo": "/assets/divisiones/slide_561_img_1.png",
    "resena": "EL ANGEL SALINAS” N° 33 L Compañía Comando y Servicios Nº 33, unidad orgánica de la 33ª Brigada de Infantería. Fue organizada para proporcionar apoyo directo al comandante, Estado Mayor y Cuartel General de esta Gran Unidad de Combate. Cumple funciones de seguridad, administración, mantenimiento, transporte y sostenimiento de las actividades del puesto de comando. Su personal ha apoyado el planeamiento y conducción de las operaciones contraterroristas desarrolladas por la brigada en el VRAEM. Su sede se encuentra en la ciudad de Quillabamba, provincia de La Convención, región Cusco.",
    "page": 561,
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 33",
        "resena": "EL ANGEL SALINAS” N° 33 L Compañía Comando y Servicios Nº 33, unidad orgánica de la 33ª Brigada de Infantería. Fue organizada para proporcionar apoyo directo al comandante, Estado Mayor y Cuartel General de esta Gran Unidad de Combate. Cumple funciones de seguridad, administración, mantenimiento, transporte y sostenimiento de las actividades del puesto de comando. Su personal ha apoyado el planeamiento y conducción de las operaciones contraterroristas desarrolladas por la brigada en el VRAEM. Su sede se encuentra en la ciudad de Quillabamba, provincia de La Convención, región Cusco."
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 33",
        "resena": "EL ANGEL SALINAS” N° 33 The Compañía Comando y Servicios Nº 33 is an organic unit of the 33ª Brigada de Infantería. It was organized to provide direct support to the commander, Estado Mayor, and Cuartel General of this Gran Unidad de Combate. It performs security, administration, maintenance, transportation, and sustainment functions for command-post activities. Its personnel have supported the planning and conduct of counterterrorism operations carried out by the brigade in the VRAEM. Its headquarters are in the city of Quillabamba, provincia de La Convención, región Cusco."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 33",
        "resena": "EL ANGEL SALINAS” N° 33 Compañía Comando y Servicios Nº 33qa 33ª Brigada de Infantería-pa unidad orgánican. Kay Gran Unidad de Combate-pa comandante, Estado Mayor y Cuartel General-ninman directo yanapay qunanpaq wakichisqa karqan. Puesto de comando ruwaykunapa seguridad, administración, mantenimiento, transporte chaymanta sostenimiento-ninta hunt'an. Runankunaqa Brigada-pa VRAEM nisqapi operaciones contraterroristas planificay chaymanta purichiyninta yanaparqanku. Kamachina wasinqa Quillabamba llaqta, La Convención provincia, Cusco regiónpin kachkan."
      }
    }
  },
  "compaacomunicacionesn33": {
    "nombre": "COMPAÑÍA COMUNICACIONES N° 33",
    "escudo": "/assets/divisiones/slide_563_img_1.png",
    "resena": "ES “TTE MIGUEL ÁNGEL SALDAÑA RAMÍREZ” N° 33 La Compañía de Comunicaciones Nº 33 es una pequeña unidad orgánica de la 33ª Brigada de Infantería, creada el año 2013 con RM N° 013-2012 Su misión es proporcionar apoyo de comunicaciones al comando y facilitar la conducción de las operaciones de esta Gran Unidad de Combate. Instala, opera y mantiene los sistemas de radio, telefonía, transmisión de datos y otros medios empleados en los puestos de comando. Ha sostenido los enlaces durante las operaciones contraterroristas y acciones militares ejecutadas por la brigada en el ámbito del VRAEM. Su sede se encuentra en la ciudad de Quillabamba, provincia de La Convención, región Cusco.",
    "page": 563,
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMUNICACIONES N° 33",
        "resena": "ES “TTE MIGUEL ÁNGEL SALDAÑA RAMÍREZ” N° 33 La Compañía de Comunicaciones Nº 33 es una pequeña unidad orgánica de la 33ª Brigada de Infantería, creada el año 2013 con RM N° 013-2012 Su misión es proporcionar apoyo de comunicaciones al comando y facilitar la conducción de las operaciones de esta Gran Unidad de Combate. Instala, opera y mantiene los sistemas de radio, telefonía, transmisión de datos y otros medios empleados en los puestos de comando. Ha sostenido los enlaces durante las operaciones contraterroristas y acciones militares ejecutadas por la brigada en el ámbito del VRAEM. Su sede se encuentra en la ciudad de Quillabamba, provincia de La Convención, región Cusco."
      },
      "en": {
        "nombre": "COMPAÑÍA COMUNICACIONES N° 33",
        "resena": "ES “TTE MIGUEL ÁNGEL SALDAÑA RAMÍREZ” N° 33 The Compañía de Comunicaciones Nº 33 is a small organic unit of the 33ª Brigada de Infantería, created in 2013 by RM N° 013-2012. Its mission is to provide communications support to the command and facilitate the conduct of operations by this Gran Unidad de Combate. It installs, operates, and maintains radio, telephone, data transmission, and other systems used at command posts. It has maintained communications during counterterrorism operations and military actions conducted by the brigade within the VRAEM. Its headquarters are in the city of Quillabamba, provincia de La Convención, región Cusco."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMUNICACIONES N° 33",
        "resena": "ES “TTE MIGUEL ÁNGEL SALDAÑA RAMÍREZ” N° 33 Compañía de Comunicaciones Nº 33qa 33ª Brigada de Infantería-pa pequeña unidad orgánican; RM N° 013-2012 kamachiywan 2013 watapi kamasqa. Misiónninmi Comando-man comunicaciones yanapay qun chaymanta kay Gran Unidad de Combate-pa operaciones purichiyninta facilitan. Puestos de comando nisqapi radio, telefonía, transmisión de datos chaymanta wak medios sistemas nisqakunata churan, llamk'achin chaymanta allichan. VRAEM nisqapi Brigada ruwasqan operaciones contraterroristas chaymanta acciones militares pachapi enlaces waqaycharqan. Kamachina wasinqa Quillabamba llaqta, La Convención provincia, Cusco regiónpin kachkan."
      }
    }
  },
