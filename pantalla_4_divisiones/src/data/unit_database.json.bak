  "compaaantitanquemyjhonymoralesrodriguezn1": {
    "nombre": "COMPAÑÍA ANTITANQUE “MY JHONY MORALES RODRIGUEZ” N° 1",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA ANTITANQUE “MY JHONY MORALES RODRIGUEZ” N° 1",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Cia AT N° 1, fue organizada para proporcionar defensa antitanque a la 1ª Brigada de Infantería; las fuentes públicas consultadas no precisan su fecha exacta de creación. Su misión es destruir o neutralizar vehículos blindados enemigos y proteger las posiciones, vías de aproximación y sectores asignados a la brigada. Su personal se prepara en reconocimiento de blindados, selección de posiciones, empleo de armas antitanque y coordinación del fuego con las unidades de maniobra. Por su ubicación fronteriza, participa en ejercicios tácticos, vigilancia de fronteras y preparación operacional en el departamento de Tumbes. Es orgánica de la 1.ª Brigada de Infantería de la I División de Ejército y tiene su sede en el Fuerte “Zarumilla”, provincia de Zarumilla.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA ANTITANQUE “MY JHONY MORALES RODRIGUEZ” N° 1",
        "resena": "La Cia AT N° 1, fue organizada para proporcionar defensa antitanque a la 1ª Brigada de Infantería; las fuentes públicas consultadas no precisan su fecha exacta de creación. Su misión es destruir o neutralizar vehículos blindados enemigos y proteger las posiciones, vías de aproximación y sectores asignados a la brigada. Su personal se prepara en reconocimiento de blindados, selección de posiciones, empleo de armas antitanque y coordinación del fuego con las unidades de maniobra. Por su ubicación fronteriza, participa en ejercicios tácticos, vigilancia de fronteras y preparación operacional en el departamento de Tumbes. Es orgánica de la 1.ª Brigada de Infantería de la I División de Ejército y tiene su sede en el Fuerte “Zarumilla”, provincia de Zarumilla."
      },
      "en": {
        "nombre": "COMPAÑÍA ANTITANQUE “MY JHONY MORALES RODRIGUEZ” N° 1",
        "resena": "The Cia AT N° 1 was organized to provide antitank defense for the 1ª Brigada de Infantería; the public sources consulted do not specify its exact date of creation. Its mission is to destroy or neutralize enemy armored vehicles and protect the positions, avenues of approach, and sectors assigned to the brigade. Its personnel train in armored-vehicle recognition, position selection, the employment of antitank weapons, and fire coordination with maneuver units. Because of its border location, it participates in tactical exercises, border surveillance, and operational readiness activities in the department of Tumbes. It is an organic unit of the 1.ª Brigada de Infantería of the I División de Ejército and is based at Fuerte “Zarumilla,” province of Zarumilla."
      },
      "qu": {
        "nombre": "COMPAÑÍA ANTITANQUE “MY JHONY MORALES RODRIGUEZ” N° 1",
        "resena": "Cia AT N° 1 nisqaqa 1ª Brigada de Infanteríaman defensa antitanque qunanpaq wakichisqa karqan; fuentes públicas nisqaqa kamarisqa fecha exactanta mana willankuchu. Misión-ninmi awqa vehículos blindados nisqakunata chinkachiy utaq mana llamk'aqta ruray, brigadapa posiciones, vías de aproximación y sectores asignados nisqakunata waqaychay. Personalnin blindados reconocimiento, posiciones akllay, armas antitanque llamk'achiy hinallataq unidades de maniobrawan fuego coordinaciónpi yachachikun. Frontera qayllapi kasqanrayku departamento de Tumbespi ejercicios tácticos, frontera vigilancia hinallataq preparación operacional nisqakunapi yanapan. I División de Ejércitopa 1.ª Brigada de Infanteríapa unidad orgánica-ninmi; sede-nin Fuerte “Zarumilla”, provincia de Zarumilla nisqapi kachkan."
      }
    }
  },
