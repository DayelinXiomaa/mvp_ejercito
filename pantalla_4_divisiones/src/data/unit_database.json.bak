  "grupodeartilleradecampaacaboalfredomaldonadon123": {
    "nombre": "GRUPO DE ARTILLERÍA DE CAMPAÑA “CABO ALFREDO MALDONADO” N° 123",
    "tipo": "Unidad Orgánica",
    "alias": "GRUPO DE ARTILLERÍA DE CAMPAÑA “CABO ALFREDO MALDONADO” N° 123",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Fue creado mediante el Decreto Supremo Nº 018-68/GU del 2 de agosto de 1968, iniciando oficialmente sus actividades el 1 de enero de 1969. Por Resolución Ministerial Nº 1030-69 GU/AG del 19 de mayo de 1969 recibió el nombre honorífico de “Cabo Alfredo Maldonado”. La unidad fue activada en Tingo, Arequipa, como elemento orgánico de la entonces Tercera Región Militar. Entre 1989 y 1998 participó en operaciones contrasubversivas en apoyo del proceso de pacificación nacional. También intervino en acciones de Defensa Civil ante desastres naturales, destacando su apoyo durante el terremoto de 1996. Su epónimo recuerda al joven artillero Alfredo Maldonado Arias, quien se inmoló en la batería Ciudadela durante la batalla de Arica de 1880.\n\nTiene su sede en el Fuerte “Coronel Justo Arias Aragüez”, Arequipa.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "GRUPO DE ARTILLERÍA DE CAMPAÑA “CABO ALFREDO MALDONADO” N° 123",
        "resena": "Fue creado mediante el Decreto Supremo Nº 018-68/GU del 2 de agosto de 1968, iniciando oficialmente sus actividades el 1 de enero de 1969. Por Resolución Ministerial Nº 1030-69 GU/AG del 19 de mayo de 1969 recibió el nombre honorífico de “Cabo Alfredo Maldonado”. La unidad fue activada en Tingo, Arequipa, como elemento orgánico de la entonces Tercera Región Militar. Entre 1989 y 1998 participó en operaciones contrasubversivas en apoyo del proceso de pacificación nacional. También intervino en acciones de Defensa Civil ante desastres naturales, destacando su apoyo durante el terremoto de 1996. Su epónimo recuerda al joven artillero Alfredo Maldonado Arias, quien se inmoló en la batería Ciudadela durante la batalla de Arica de 1880.\n\nTiene su sede en el Fuerte “Coronel Justo Arias Aragüez”, Arequipa."
      },
      "en": {
        "nombre": "GRUPO DE ARTILLERÍA DE CAMPAÑA “CABO ALFREDO MALDONADO” N° 123",
        "resena": "It was created by Decreto Supremo Nº 018-68/GU of August 2, 1968, and officially began operations on January 1, 1969. By Resolución Ministerial Nº 1030-69 GU/AG of May 19, 1969, it received the honorary name “Cabo Alfredo Maldonado”. The unit was activated in Tingo, Arequipa, as an organic element of the then Tercera Región Militar. Between 1989 and 1998, it participated in counterinsurgency operations supporting the national pacification process. It also took part in Defensa Civil actions during natural disasters, notably providing support after the 1996 earthquake. Its namesake commemorates the young artilleryman Alfredo Maldonado Arias, who sacrificed himself at batería Ciudadela during the batalla de Arica de 1880. Its headquarters are at Fuerte “Coronel Justo Arias Aragüez”, Arequipa."
      },
      "qu": {
        "nombre": "GRUPO DE ARTILLERÍA DE CAMPAÑA “CABO ALFREDO MALDONADO” N° 123",
        "resena": "Decreto Supremo Nº 018-68/GU, 2 agosto 1968 kamachiywan kamasqa, 1 enero 1969 p'unchawmi llamk'ariyta qallariyrqan. Resolución Ministerial Nº 1030-69 GU/AG, 19 mayo 1969 kamachiywan “Cabo Alfredo Maldonado” sutita chaskirqan. Unidadqa Tingo, Arequipa llaqtapi ñawpaq Tercera Región Militar-pa unidad orgánican hina llamk'ariyta qallariyrqan. 1989–1998 watakunapi pacificación nacional yanapanapaq operaciones contrasubversivas nisqapi llamk'arqan. Desastres naturales pachapi Defensa Civil ruwaykunapipas yanaparqan, aswanqa terremoto de 1996 qhipaman. Sutinqa wayna artillero Alfredo Maldonado Arias-ta yuyarin; payqa batalla de Arica, 1880 pachapi batería Ciudadela nisqapi kawsayninta qurqan. Kamachina wasinqa Fuerte “Coronel Justo Arias Aragüez”, Arequipa llaqtapin kachkan."
      }
    }
  },
