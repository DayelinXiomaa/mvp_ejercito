  "compaacomunicacionesttemiguelngelsaldaaramrezn33": {
    "nombre": "COMPAÑÍA COMUNICACIONES “TTE MIGUEL ÁNGEL SALDAÑA RAMÍREZ” N° 33",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA COMUNICACIONES “TTE MIGUEL ÁNGEL SALDAÑA RAMÍREZ” N° 33",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía de Comunicaciones Nº 33 es una pequeña unidad orgánica de la 33ª Brigada de Infantería, creada el año 2013 con RM N° 013-2012 Su misión es proporcionar apoyo de comunicaciones al comando y facilitar la conducción de las operaciones de esta Gran Unidad de Combate. Instala, opera y mantiene los sistemas de radio, telefonía, transmisión de datos y otros medios empleados en los puestos de comando. Ha sostenido los enlaces durante las operaciones contraterroristas y acciones militares ejecutadas por la brigada en el ámbito del VRAEM.\n\nSu sede se encuentra en la ciudad de Quillabamba, provincia de La Convención, región Cusco.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMUNICACIONES “TTE MIGUEL ÁNGEL SALDAÑA RAMÍREZ” N° 33",
        "resena": "La Compañía de Comunicaciones Nº 33 es una pequeña unidad orgánica de la 33ª Brigada de Infantería, creada el año 2013 con RM N° 013-2012 Su misión es proporcionar apoyo de comunicaciones al comando y facilitar la conducción de las operaciones de esta Gran Unidad de Combate. Instala, opera y mantiene los sistemas de radio, telefonía, transmisión de datos y otros medios empleados en los puestos de comando. Ha sostenido los enlaces durante las operaciones contraterroristas y acciones militares ejecutadas por la brigada en el ámbito del VRAEM.\n\nSu sede se encuentra en la ciudad de Quillabamba, provincia de La Convención, región Cusco."
      },
      "en": {
        "nombre": "COMPAÑÍA COMUNICACIONES “TTE MIGUEL ÁNGEL SALDAÑA RAMÍREZ” N° 33",
        "resena": "The Compañía de Comunicaciones Nº 33 is a small organic unit of the 33ª Brigada de Infantería, created in 2013 by RM N° 013-2012. Its mission is to provide communications support to the command and facilitate the conduct of operations by this Gran Unidad de Combate. It installs, operates, and maintains radio, telephone, data transmission, and other systems used at command posts. It has maintained communications during counterterrorism operations and military actions conducted by the brigade within the VRAEM. Its headquarters are in the city of Quillabamba, provincia de La Convención, región Cusco."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMUNICACIONES “TTE MIGUEL ÁNGEL SALDAÑA RAMÍREZ” N° 33",
        "resena": "Compañía de Comunicaciones Nº 33qa 33ª Brigada de Infantería-pa pequeña unidad orgánican; RM N° 013-2012 kamachiywan 2013 watapi kamasqa. Misiónninmi Comando-man comunicaciones yanapay qun chaymanta kay Gran Unidad de Combate-pa operaciones purichiyninta facilitan. Puestos de comando nisqapi radio, telefonía, transmisión de datos chaymanta wak medios sistemas nisqakunata churan, llamk'achin chaymanta allichan. VRAEM nisqapi Brigada ruwasqan operaciones contraterroristas chaymanta acciones militares pachapi enlaces waqaycharqan. Kamachina wasinqa Quillabamba llaqta, La Convención provincia, Cusco regiónpin kachkan."
      }
    }
  },
