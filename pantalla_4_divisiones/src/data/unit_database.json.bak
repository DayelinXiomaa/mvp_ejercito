  "compaaantitanquecapepmiltonmolinajimenezn644": {
    "nombre": "COMPAÑÍA ANTITANQUE “CAP EP MILTON MOLINA JIMENEZ” N° 644",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA ANTITANQUE “CAP EP MILTON MOLINA JIMENEZ” N° 644",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Antitanque Nº 644 es una pequeña unidad orgánica del Agrupamiento Antitanque «Cazadores» Nº 3 de la III División de Ejército. Lleva el nombre del capitán EP Milton Guido Molina Jiménez, natural de San Ignacio, Cajamarca, en reconocimiento a su valor y sacrificio. El entonces teniente Molina Jiménez falleció el 24 de noviembre de 2010 durante una operación contraterrorista en la provincia de Satipo, Junín. La unidad cumple misiones de defensa antiblindaje y prepara a su personal en reconocimiento, enmascaramiento y operación de sistemas antitanque.\n\nTiene su sede en Ite, región Tacna.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA ANTITANQUE “CAP EP MILTON MOLINA JIMENEZ” N° 644",
        "resena": "La Compañía Antitanque Nº 644 es una pequeña unidad orgánica del Agrupamiento Antitanque «Cazadores» Nº 3 de la III División de Ejército. Lleva el nombre del capitán EP Milton Guido Molina Jiménez, natural de San Ignacio, Cajamarca, en reconocimiento a su valor y sacrificio. El entonces teniente Molina Jiménez falleció el 24 de noviembre de 2010 durante una operación contraterrorista en la provincia de Satipo, Junín. La unidad cumple misiones de defensa antiblindaje y prepara a su personal en reconocimiento, enmascaramiento y operación de sistemas antitanque.\n\nTiene su sede en Ite, región Tacna."
      },
      "en": {
        "nombre": "COMPAÑÍA ANTITANQUE “CAP EP MILTON MOLINA JIMENEZ” N° 644",
        "resena": "The Compañía Antitanque Nº 644 is a small organic unit of the Agrupamiento Antitanque «Cazadores» Nº 3 of the III División de Ejército. It is named after capitán EP Milton Guido Molina Jiménez, a native of San Ignacio, Cajamarca, in recognition of his courage and sacrifice. Then-teniente Molina Jiménez died on November 24, 2010, during a counterterrorism operation in the provincia de Satipo, Junín. The unit performs anti-armor defense missions and trains its personnel in reconnaissance, concealment, and the operation of antitank systems. Its headquarters are in Ite, región Tacna."
      },
      "qu": {
        "nombre": "COMPAÑÍA ANTITANQUE “CAP EP MILTON MOLINA JIMENEZ” N° 644",
        "resena": "Compañía Antitanque Nº 644qa III División de Ejército-pa Agrupamiento Antitanque «Cazadores» Nº 3 nisqanpa pequeña unidad orgánican. Capitán EP Milton Guido Molina Jiménez-pa sutinta apan; payqa San Ignacio, Cajamarca llaqtamanta karqan, valor chaymanta sacrificion yupaychasqa. Chay pachapi teniente Molina Jiménezqa 24 noviembre 2010 p'unchaw Satipo provincia, Junín llaqtapi operación contraterrorista nisqapi wañurqan. Unidadqa defensa antiblindaje misiónkunata hunt'an, runankunatataq reconocimiento, enmascaramiento chaymanta sistemas antitanque llamk'achiy yachachin. Kamachina wasinqa Ite, Tacna regiónpin kachkan."
      }
    }
  },
