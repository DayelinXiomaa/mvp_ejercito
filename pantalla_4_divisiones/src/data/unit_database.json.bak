  "batallndeselvaloreton53": {
    "nombre": "BATALLÓN DE SELVA “ LORETO” N° 53",
    "tipo": "Unidad Orgánica",
    "alias": "BATALLÓN DE SELVA “ LORETO” N° 53",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Fue creado el 23 de diciembre de 1957 con la denominación de Batallón de Infantería de Selva Nº 53. Mediante Resolución Ministerial Nº 102/CGE, del 24 de febrero de 1958, recibió el nombre honorífico de “Loreto”. Esta denominación honra a los combatientes amazónicos que entregaron su vida defendiendo la soberanía e integridad territorial del Perú. Desde 1992 mantiene presencia en la cuenca del río Corrientes, desarrollando tareas de vigilancia fronteriza y apoyo a las comunidades amazónicas.\n\nSu sede se encuentra en la guarnición de Teniente López, distrito de Trompeteros, provincia y región Loreto.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATALLÓN DE SELVA “ LORETO” N° 53",
        "resena": "Fue creado el 23 de diciembre de 1957 con la denominación de Batallón de Infantería de Selva Nº 53. Mediante Resolución Ministerial Nº 102/CGE, del 24 de febrero de 1958, recibió el nombre honorífico de “Loreto”. Esta denominación honra a los combatientes amazónicos que entregaron su vida defendiendo la soberanía e integridad territorial del Perú. Desde 1992 mantiene presencia en la cuenca del río Corrientes, desarrollando tareas de vigilancia fronteriza y apoyo a las comunidades amazónicas.\n\nSu sede se encuentra en la guarnición de Teniente López, distrito de Trompeteros, provincia y región Loreto."
      },
      "en": {
        "nombre": "BATALLÓN DE SELVA “ LORETO” N° 53",
        "resena": "It was created on December 23, 1957, under the name Batallón de Infantería de Selva Nº 53. By Resolución Ministerial Nº 102/CGE of February 24, 1958, it received the honorary name “Loreto”. This name honors the Amazonian combatants who gave their lives defending Peru's sovereignty and territorial integrity. Since 1992, it has maintained a presence in the río Corrientes basin, conducting border-surveillance tasks and supporting Amazonian communities. Its headquarters are in guarnición de Teniente López, distrito de Trompeteros, provincia y región Loreto."
      },
      "qu": {
        "nombre": "BATALLÓN DE SELVA “ LORETO” N° 53",
        "resena": "23 de diciembre de 1957 p'unchawmi Batallón de Infantería de Selva Nº 53 sutiyuq paqarichisqa karqan. Resolución Ministerial Nº 102/CGE, 24 de febrero de 1958 kamachiywan “Loreto” yupaychana sutinta chaskirqan. Kay sutinqa Perúpa soberanía hinallataq integridad territorialnin amachaypi kawsayninkuta quq Amazonía maqanakuy runakunata yupaychan. 1992 watamanta río Corrientes cuencapi kachkan, fronterata qhawaspa Amazonía llaqtakunata yanapaspa. Sedenmi Teniente López guarnición, Trompeteros distrito, Loreto provincia hinallataq suyupi kachkan."
      }
    }
  },
