  "compaadecomunicacionesdeserviciosn115": {
    "nombre": "COMPAÑÍA DE COMUNICACIONES DE SERVICIOS N° 115",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA DE COMUNICACIONES DE SERVICIOS N° 115",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Es conocida como Compañía de Comunicaciones de Servicios Nº 115 o “Cía. Com Serv Nº 115”. Su misión es instalar, operar y mantener los sistemas de comunicaciones que permiten el mando y control de la 5.ª Brigada de Servicios. Asimismo, forma personal en la operación de radios militares y otros sistemas, garantizando los enlaces necesarios para el sostenimiento logístico de la V División de Ejército. Es orgánica de la 5.ª Brigada de Servicios y tiene su sede en el Fuerte Militar “Soldado Alfredo Vargas Guerra”, Iquitos, Loreto.",
    "escudo": "/assets/divisiones/slide_673_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA DE COMUNICACIONES DE SERVICIOS N° 115",
        "resena": "Es conocida como Compañía de Comunicaciones de Servicios Nº 115 o “Cía. Com Serv Nº 115”. Su misión es instalar, operar y mantener los sistemas de comunicaciones que permiten el mando y control de la 5.ª Brigada de Servicios. Asimismo, forma personal en la operación de radios militares y otros sistemas, garantizando los enlaces necesarios para el sostenimiento logístico de la V División de Ejército. Es orgánica de la 5.ª Brigada de Servicios y tiene su sede en el Fuerte Militar “Soldado Alfredo Vargas Guerra”, Iquitos, Loreto."
      },
      "en": {
        "nombre": "COMPAÑÍA DE COMUNICACIONES DE SERVICIOS N° 115",
        "resena": "It is known as Compañía de Comunicaciones de Servicios Nº 115 or “Cía. Com Serv Nº 115”. Its mission is to install, operate, and maintain the communications systems that enable command and control of the 5.ª Brigada de Servicios. It also trains personnel in the operation of military radios and other systems, ensuring the communications required for the logistical sustainment of the V División de Ejército. It is an organic unit of the 5.ª Brigada de Servicios and has its headquarters at Fuerte Militar “Soldado Alfredo Vargas Guerra”, Iquitos, Loreto."
      },
      "qu": {
        "nombre": "COMPAÑÍA DE COMUNICACIONES DE SERVICIOS N° 115",
        "resena": "Compañía de Comunicaciones de Servicios Nº 115 utaq “Cía. Com Serv Nº 115” sutichawan riqsisqa. Misiónninmi 5.ª Brigada de Servicios-pa mando y controlninta atichiq comunicaciones sistemakunata churay, purichiy, waqaychay. Chaynallataq radios militares hinallataq wak sistemakuna purichiypi personalta yachachin, V División de Ejército-pa logística sostenimientonpaq enlacekunata allin purichispa. 5.ª Brigada de Servicios-pa unidad orgánica-ninmi; sedenqa Fuerte Militar “Soldado Alfredo Vargas Guerra”, Iquitos, Loreto llaqtapi kachkan."
      }
    }
  },
