  "compaaantitanquestteinfortizflorescelsojuann636": {
    "nombre": "COMPAÑÍA ANTITANQUE “STTE INF ORTIZ FLORES CELSO JUAN” N° 636",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA ANTITANQUE “STTE INF ORTIZ FLORES CELSO JUAN” N° 636",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Antitanque Nº 636 es una pequeña unidad orgánica del Agrupamiento Antitanque «Cazadores» Nº 3 de la III División de Ejército. Lleva el nombre del subteniente Celso Juan Ortiz Flores, quien comandó la patrulla «Lobo» durante las operaciones contraterroristas de 1991. El 27 de septiembre de ese año, fue herido mortalmente al cubrir la retirada de sus soldados durante una emboscada en el cerro Tapuna, Ayacucho. La unidad cumple misiones de defensa antiblindaje y prepara a su personal en reconocimiento, enmascaramiento y operación de sistemas antitanque.\n\nTiene su sede en Ite, región Tacna.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA ANTITANQUE “STTE INF ORTIZ FLORES CELSO JUAN” N° 636",
        "resena": "La Compañía Antitanque Nº 636 es una pequeña unidad orgánica del Agrupamiento Antitanque «Cazadores» Nº 3 de la III División de Ejército. Lleva el nombre del subteniente Celso Juan Ortiz Flores, quien comandó la patrulla «Lobo» durante las operaciones contraterroristas de 1991. El 27 de septiembre de ese año, fue herido mortalmente al cubrir la retirada de sus soldados durante una emboscada en el cerro Tapuna, Ayacucho. La unidad cumple misiones de defensa antiblindaje y prepara a su personal en reconocimiento, enmascaramiento y operación de sistemas antitanque.\n\nTiene su sede en Ite, región Tacna."
      },
      "en": {
        "nombre": "COMPAÑÍA ANTITANQUE “STTE INF ORTIZ FLORES CELSO JUAN” N° 636",
        "resena": "The Compañía Antitanque Nº 636 is a small organic unit of the Agrupamiento Antitanque «Cazadores» Nº 3 of the III División de Ejército. It is named after subteniente Celso Juan Ortiz Flores, who commanded patrol «Lobo» during the 1991 counterterrorism operations. On September 27 of that year, he was mortally wounded while covering the withdrawal of his soldiers during an ambush at cerro Tapuna, Ayacucho. The unit performs anti-armor defense missions and trains its personnel in reconnaissance, concealment, and the operation of antitank systems. Its headquarters are in Ite, región Tacna."
      },
      "qu": {
        "nombre": "COMPAÑÍA ANTITANQUE “STTE INF ORTIZ FLORES CELSO JUAN” N° 636",
        "resena": "Compañía Antitanque Nº 636qa III División de Ejército-pa Agrupamiento Antitanque «Cazadores» Nº 3 nisqanpa pequeña unidad orgánican. Subteniente Celso Juan Ortiz Flores-pa sutinta apan; payqa 1991 watapi operaciones contraterroristas pachapi patrulla «Lobo» nisqata kamachirqan. 27 septiembre chay watapi cerro Tapuna, Ayacucho llaqtapi emboscada pachapi soldadonkuna kutirinanpaq waqaychaspa wañuypaq k'irisqa karqan. Unidadqa defensa antiblindaje misiónkunata hunt'an, runankunatataq reconocimiento, enmascaramiento chaymanta sistemas antitanque llamk'achiy yachachin. Kamachina wasinqa Ite, Tacna regiónpin kachkan."
      }
    }
  },
