  "compaacomandoyserviciosttemiguelangelsalinasn33": {
    "nombre": "COMPAÑÍA COMANDO Y SERVICIOS “TTE MIGUEL ANGEL SALINAS” N° 33",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA COMANDO Y SERVICIOS “TTE MIGUEL ANGEL SALINAS” N° 33",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "L Compañía Comando y Servicios Nº 33, unidad orgánica de la 33ª Brigada de Infantería. Fue organizada para proporcionar apoyo directo al comandante, Estado Mayor y Cuartel General de esta Gran Unidad de Combate. Cumple funciones de seguridad, administración, mantenimiento, transporte y sostenimiento de las actividades del puesto de comando. Su personal ha apoyado el planeamiento y conducción de las operaciones contraterroristas desarrolladas por la brigada en el VRAEM.\n\nSu sede se encuentra en la ciudad de Quillabamba, provincia de La Convención, región Cusco.",
    "escudo": "/assets/divisiones/slide_561_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS “TTE MIGUEL ANGEL SALINAS” N° 33",
        "resena": "L Compañía Comando y Servicios Nº 33, unidad orgánica de la 33ª Brigada de Infantería. Fue organizada para proporcionar apoyo directo al comandante, Estado Mayor y Cuartel General de esta Gran Unidad de Combate. Cumple funciones de seguridad, administración, mantenimiento, transporte y sostenimiento de las actividades del puesto de comando. Su personal ha apoyado el planeamiento y conducción de las operaciones contraterroristas desarrolladas por la brigada en el VRAEM.\n\nSu sede se encuentra en la ciudad de Quillabamba, provincia de La Convención, región Cusco."
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS “TTE MIGUEL ANGEL SALINAS” N° 33",
        "resena": "The Compañía Comando y Servicios Nº 33 is an organic unit of the 33ª Brigada de Infantería. It was organized to provide direct support to the commander, Estado Mayor, and Cuartel General of this Gran Unidad de Combate. It performs security, administration, maintenance, transportation, and sustainment functions for command-post activities. Its personnel have supported the planning and conduct of counterterrorism operations carried out by the brigade in the VRAEM. Its headquarters are in the city of Quillabamba, provincia de La Convención, región Cusco."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS “TTE MIGUEL ANGEL SALINAS” N° 33",
        "resena": "Compañía Comando y Servicios Nº 33qa 33ª Brigada de Infantería-pa unidad orgánican. Kay Gran Unidad de Combate-pa comandante, Estado Mayor y Cuartel General-ninman directo yanapay qunanpaq wakichisqa karqan. Puesto de comando ruwaykunapa seguridad, administración, mantenimiento, transporte chaymanta sostenimiento-ninta hunt'an. Runankunaqa Brigada-pa VRAEM nisqapi operaciones contraterroristas planificay chaymanta purichiyninta yanaparqanku. Kamachina wasinqa Quillabamba llaqta, La Convención provincia, Cusco regiónpin kachkan."
      }
    }
  },
