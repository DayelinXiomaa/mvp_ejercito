  "batallndeinfanteramotorizadotrujillon38": {
    "nombre": "BATALLÓN DE INFANTERÍA MOTORIZADO “TRUJILLO” N° 38",
    "tipo": "Unidad Orgánica",
    "alias": "BATALLÓN DE INFANTERÍA MOTORIZADO “TRUJILLO” N° 38",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Fue creado mediante Decreto Supremo del 30 de mayo de 1980 y recibió el nombre de “Trujillo”. Antes de su activación, su cuadro de oficiales permaneció en las instalaciones del BIM “Pucará” N° 37, en Trujillo. Al organizarse en 1980 fue acantonado en Chocope, provincia de Ascope, región La Libertad. En 1985 se constituyó como Batallón de Infantería Motorizado y fue trasladado al entonces Fuerte “Chiclayo”. Como unidad de la 7ª División de Infantería participó en las operaciones desarrolladas durante los conflictos de 1981 y 1995. Desde agosto de 1992 intensificó sus operaciones contrasubversivas y mantuvo bases destinadas a garantizar el orden interno. También intervino en tareas de pacificación y en la atención de emergencias ocasionadas por el fenómeno de El Niño. Actualmente integra la 7ª Brigada de Infantería y tiene su sede en el Fuerte “Andrés Avelino Cáceres”, Pimentel, Lambayeque.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATALLÓN DE INFANTERÍA MOTORIZADO “TRUJILLO” N° 38",
        "resena": "Fue creado mediante Decreto Supremo del 30 de mayo de 1980 y recibió el nombre de “Trujillo”. Antes de su activación, su cuadro de oficiales permaneció en las instalaciones del BIM “Pucará” N° 37, en Trujillo. Al organizarse en 1980 fue acantonado en Chocope, provincia de Ascope, región La Libertad. En 1985 se constituyó como Batallón de Infantería Motorizado y fue trasladado al entonces Fuerte “Chiclayo”. Como unidad de la 7ª División de Infantería participó en las operaciones desarrolladas durante los conflictos de 1981 y 1995. Desde agosto de 1992 intensificó sus operaciones contrasubversivas y mantuvo bases destinadas a garantizar el orden interno. También intervino en tareas de pacificación y en la atención de emergencias ocasionadas por el fenómeno de El Niño. Actualmente integra la 7ª Brigada de Infantería y tiene su sede en el Fuerte “Andrés Avelino Cáceres”, Pimentel, Lambayeque."
      },
      "en": {
        "nombre": "BATALLÓN DE INFANTERÍA MOTORIZADO “TRUJILLO” N° 38",
        "resena": "It was created by Decreto Supremo of May 30, 1980, and received the name “Trujillo.” Before its activation, its officer cadre remained at the facilities of BIM “Pucará” N° 37 in Trujillo. Upon its organization in 1980, it was stationed in Chocope, province of Ascope, region of La Libertad. In 1985, it became a Batallón de Infantería Motorizado and was transferred to the then Fuerte “Chiclayo.” As a unit of the 7ª División de Infantería, it participated in the operations conducted during the conflicts of 1981 and 1995. From August 1992 onward, it intensified its counter-subversive operations and maintained bases intended to guarantee internal order. It also participated in pacification duties and emergency response operations caused by the El Niño phenomenon. It currently forms part of the 7ª Brigada de Infantería and is headquartered at Fuerte “Andrés Avelino Cáceres,” Pimentel, Lambayeque."
      },
      "qu": {
        "nombre": "BATALLÓN DE INFANTERÍA MOTORIZADO “TRUJILLO” N° 38",
        "resena": "Decreto Supremo del 30 de mayo de 1980 nisqawan kamarisqa, “Trujillo” sutita hap'irqan. Manaraq activasqa kachkaptin oficialesnin Trujillopi BIM “Pucará” N° 37 nisqapi qhiparqanku. 1980 watapi Chocope, provincia de Ascope, región La Libertad nisqapi acantonasqa karqan. 1985 watapi Batallón de Infantería Motorizado hina churakuspa Fuerte “Chiclayo” nisqaman apasqa. 7ª División de Infanteríapa unidadnin hina, 1981 y 1995 watakunapi conflictos operacionespi yanaparqan. 1992 watapi agosto killamantapacha operaciones contrasubversivas nisqakunata sinchiyachirqan, orden interno waqaychanapaq baseskunata hap'ispa. Pacificación ruraykunapi hinallataq fenómeno de El Niñopa emergenciasninpi yanaparqan. Kunan 7ª Brigada de Infanteríaman hukllachisqa; sede-ninmi Fuerte “Andrés Avelino Cáceres”, Pimentel, Lambayeque nisqapi kachkan."
      }
    }
  },
