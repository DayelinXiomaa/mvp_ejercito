  "escuadrncomandoyserviciosn51": {
    "nombre": "ESCUADRÓN COMANDO Y SERVICIOS N° 51",
    "tipo": "Unidad Orgánica",
    "alias": "ESCUADRÓN COMANDO Y SERVICIOS N° 51",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "El Escuadrón Comando y Servicios N° 51, surgió como elemento de comando y apoyo del cuartel general de la brigada. Su misión principal es facilitar el mando y control, la seguridad, la administración y el sostenimiento inmediato del Estado Mayor. Ha acompañado las actividades operacionales, ejercicios y acciones de apoyo a la población desarrolladas por la 1ª Brigada de Caballería en la frontera norte. Es orgánico de la 1ª Brigada de Caballería y tiene su sede en Sullana, provincia de Sullana, departamento de Piura",
    "escudo": "/assets/divisiones/slide_146_img_1.png",
    "unidades": [],
