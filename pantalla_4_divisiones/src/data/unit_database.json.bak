  "compaapolicamilitarn600": {
    "nombre": "COMPAÑIA POLICÍA MILITAR “SO1 HUGO LARICO PAMPA” N° 600",
    "escudo": "/assets/divisiones/slide_431_img_1.png",
    "resena": "La Compañía de Policía Militar Nº 600 es una pequeña unidad orgánica de la 2ª Brigada de Selva de Protección de la Amazonía. Fue organizada para mantener la disciplina, el orden y la seguridad en las instalaciones y áreas bajo responsabilidad de la Brigada. Su misión comprende el control de accesos, protección de autoridades, custodia de instalaciones y regulación del tránsito militar. Tiene su sede en Puerto Maldonado.",
    "page": 431,
    "language": {
      "es": {
        "nombre": "COMPAÑIA POLICÍA MILITAR “SO1 HUGO LARICO PAMPA” N° 600",
        "resena": "La Compañía de Policía Militar Nº 600 es una pequeña unidad orgánica de la 2ª Brigada de Selva de Protección de la Amazonía. Fue organizada para mantener la disciplina, el orden y la seguridad en las instalaciones y áreas bajo responsabilidad de la Brigada. Su misión comprende el control de accesos, protección de autoridades, custodia de instalaciones y regulación del tránsito militar. Tiene su sede en Puerto Maldonado."
      },
      "en": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 600",
        "resena": "The Compañía de Policía Militar Nº 600 is a small organic unit of the 2ª Brigada de Selva de Protección de la Amazonía. It was organized to maintain discipline, order, and security in the facilities and areas under the Brigade’s responsibility. Its mission includes access control, protection of authorities, security of facilities, and regulation of military traffic. Its headquarters are in Puerto Maldonado."
      },
      "qu": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 600",
        "resena": "la Amazonía-pa huch'uy unidad orgánican. Brigada-pa kamachiyninpi instalaciones chaymanta kitikuna ukhupi disciplina, orden hinaspa seguridad waqaychanapaqmi wakichisqa karqan. Misiónninmi yaykuy kamachiy, autoridades amachay, instalaciones waqaychay chaymanta tránsito militar kamachiy. Kamachina wasinqa Puerto Maldonado llaqtapin kachkan."
      }
    }
  },
