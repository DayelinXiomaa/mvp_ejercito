  "compaacomandoyserviciosn603": {
    "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 603",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA COMANDO Y SERVICIOS N° 603",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Comando y Servicios Nº 603 es orgánica del Agrupamiento Antitanque «Cazadores» Nº 3 de la III División de Ejército. Fue organizada para proporcionar al comando los medios necesarios para planear, coordinar y conducir las operaciones del Agrupamiento. Instala y protege el puesto de comando, facilitando las comunicaciones, el enlace y el control de las compañías antitanque subordinadas. Asimismo, brinda apoyo administrativo, logístico, sanitario, de mantenimiento.\n\nTiene su sede en Ite, provincia de Jorge Basadre, Tacna.",
    "escudo": "/assets/divisiones/slide_458_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 603",
        "resena": "La Compañía Comando y Servicios Nº 603 es orgánica del Agrupamiento Antitanque «Cazadores» Nº 3 de la III División de Ejército. Fue organizada para proporcionar al comando los medios necesarios para planear, coordinar y conducir las operaciones del Agrupamiento. Instala y protege el puesto de comando, facilitando las comunicaciones, el enlace y el control de las compañías antitanque subordinadas. Asimismo, brinda apoyo administrativo, logístico, sanitario, de mantenimiento.\n\nTiene su sede en Ite, provincia de Jorge Basadre, Tacna."
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 603",
        "resena": "The Compañía Comando y Servicios Nº 603 is an organic unit of the Agrupamiento Antitanque «Cazadores» Nº 3 of the III División de Ejército. It was organized to provide the command with the means required to plan, coordinate, and conduct the Agrupamiento's operations. It establishes and protects the command post, facilitating communications, liaison, and control of the subordinate antitank companies. It also provides administrative, logistical, medical, and maintenance support. Its headquarters are in Ite, provincia de Jorge Basadre, Tacna."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 603",
        "resena": "Compañía Comando y Servicios Nº 603qa III División de Ejército-pa Agrupamiento Antitanque «Cazadores» Nº 3 nisqanpa unidad orgánican. Agrupamiento-pa operaciones planificay, coordinay chaymanta purichinapaq Comando-man necesario runakuna chaymanta medios qunanpaq wakichisqa karqan. Puesto de comando churan chaymanta waqaychan; comunicaciones, enlace chaymanta compañías antitanque subordinadas controlayta yanapan. Hinallataq apoyo administrativo, logístico, sanitario chaymanta mantenimiento qun. Kamachina wasinqa Ite, Jorge Basadre provincia, Tacna llaqtapin kachkan."
      }
    }
  },
