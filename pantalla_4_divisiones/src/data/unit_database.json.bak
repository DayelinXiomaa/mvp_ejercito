  "compaapolicamilitarportetedetarquin35": {
    "nombre": "COMPAÑÍA POLICÍA MILITAR “PORTETE DE TARQUI” N° 35",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA POLICÍA MILITAR “PORTETE DE TARQUI” N° 35",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Lleva la denominación histórica de “Portete de T arqui”, en recuerdo del enfrentamiento peruano-grancolombiano ocurrido el 27 de febrero de 1829. Fue organizada para proporcionar seguridad, disciplina, control de tránsito militar y custodia de instalaciones al comando de la entonces 35.ª Brigada de Selva. Su trayectoria está vinculada a las operaciones de vigilancia fronteriza, protección de la Amazonía y apoyo a las autoridades en la provincia de Mariscal Ramón Castilla. Mantiene su sede en Caballococha, departamento de Loreto, donde cumple funciones de Policía Militar en apoyo del cuartel general de la brigada.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR “PORTETE DE TARQUI” N° 35",
        "resena": "Lleva la denominación histórica de “Portete de T arqui”, en recuerdo del enfrentamiento peruano-grancolombiano ocurrido el 27 de febrero de 1829. Fue organizada para proporcionar seguridad, disciplina, control de tránsito militar y custodia de instalaciones al comando de la entonces 35.ª Brigada de Selva. Su trayectoria está vinculada a las operaciones de vigilancia fronteriza, protección de la Amazonía y apoyo a las autoridades en la provincia de Mariscal Ramón Castilla. Mantiene su sede en Caballococha, departamento de Loreto, donde cumple funciones de Policía Militar en apoyo del cuartel general de la brigada."
      },
      "en": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR “PORTETE DE TARQUI” N° 35",
        "resena": "It bears the historic name “Portete de Tarqui”, commemorating the Peruvian–Gran Colombian engagement of February 27, 1829. It was organized to provide security, discipline, military traffic control, and installation custody to the command of the former 35.ª Brigada de Selva. Its history is linked to border-surveillance operations, protection of the Amazonía, and support for authorities in provincia de Mariscal Ramón Castilla. It maintains its headquarters in Caballococha, departamento de Loreto, where it performs Military Police functions in support of the brigade headquarters."
      },
      "qu": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR “PORTETE DE TARQUI” N° 35",
        "resena": "“Portete de Tarqui” ñawpa sutinta apan, 27 de febrero de 1829 p'unchawpi enfrentamiento peruano-grancolombiano nisqata yuyarispa. Ñawpaq 35.ª Brigada de Selva-pa comandonta seguridad, disciplina, tránsito militar kamachiy hinallataq instalaciones qhawana yanapaywan qunanpaq kamarisqa. Puririsqanqa frontera qhaway operacioneswan, Amazonía amachaywan, Mariscal Ramón Castilla provinciapi autoridades-ta yanapaywan t'inkisqa. Sedenmi Caballococha, Loreto departamentopi kachkan; chaypi brigadapa cuartel generalninta Policía Militar ruwaykunawan yanapan."
      }
    }
  },
