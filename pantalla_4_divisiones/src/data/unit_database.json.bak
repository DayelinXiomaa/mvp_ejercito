  "compaaingenieradeserviciosn115": {
    "nombre": "COMPAÑÍA INGENIERÍA DE SERVICIOS N° 115",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA INGENIERÍA DE SERVICIOS N° 115",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía de Ingeniería de Servicios Nº 115; fue creada inicialmente como Batallón de Ingeniería de Servicios Nº 115 el 1 de enero de 1981. Nació como unidad orgánica de la 5ª División de Servicios de la entonces Quinta Región Militar y ocupó inicialmente el cuartel “Ramón Castilla”. En enero de 1981 participó en el conflicto de la Cordillera del Cóndor, abasteciendo y manteniendo los materiales y equipos de ingeniería empleados por las unidades combatientes. En 1988, durante la reorganización de los órganos logísticos, el batallón fue reducido y transformado en la actual Compañía de Ingeniería de Servicios Nº 115. En 2003 recibió personal y medios del desactivado Batallón de Asuntos Civiles Nº 115..\n\nSu sede se encuentra en el Fuerte Militar “Soldado Alfredo Vargas Guerra”, distrito de Iquitos, provincia de Maynas, Loreto.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA INGENIERÍA DE SERVICIOS N° 115",
        "resena": "La Compañía de Ingeniería de Servicios Nº 115; fue creada inicialmente como Batallón de Ingeniería de Servicios Nº 115 el 1 de enero de 1981. Nació como unidad orgánica de la 5ª División de Servicios de la entonces Quinta Región Militar y ocupó inicialmente el cuartel “Ramón Castilla”. En enero de 1981 participó en el conflicto de la Cordillera del Cóndor, abasteciendo y manteniendo los materiales y equipos de ingeniería empleados por las unidades combatientes. En 1988, durante la reorganización de los órganos logísticos, el batallón fue reducido y transformado en la actual Compañía de Ingeniería de Servicios Nº 115. En 2003 recibió personal y medios del desactivado Batallón de Asuntos Civiles Nº 115..\n\nSu sede se encuentra en el Fuerte Militar “Soldado Alfredo Vargas Guerra”, distrito de Iquitos, provincia de Maynas, Loreto."
      },
      "en": {
        "nombre": "COMPAÑÍA INGENIERÍA DE SERVICIOS N° 115",
        "resena": "The Compañía de Ingeniería de Servicios Nº 115 was initially created as Batallón de Ingeniería de Servicios Nº 115 on January 1, 1981. It originated as an organic unit of the 5ª División de Servicios of the former Quinta Región Militar and initially occupied cuartel “Ramón Castilla”. In January 1981, it participated in the conflicto de la Cordillera del Cóndor, supplying and maintaining engineering materials and equipment used by combat units. In 1988, during the reorganization of logistics organizations, the battalion was reduced and transformed into the current Compañía de Ingeniería de Servicios Nº 115. In 2003, it received personnel and resources from the deactivated Batallón de Asuntos Civiles Nº 115. Its headquarters are at Fuerte Militar “Soldado Alfredo Vargas Guerra”, distrito de Iquitos, provincia de Maynas, Loreto."
      },
      "qu": {
        "nombre": "COMPAÑÍA INGENIERÍA DE SERVICIOS N° 115",
        "resena": "Compañía de Ingeniería de Servicios Nº 115qa qallariypi Batallón de Ingeniería de Servicios Nº 115 sutiyuq 1 de enero de 1981 p'unchawmi paqarichisqa karqan. Ñawpaq Quinta Región Militar-pa 5ª División de Servicios ukhunpi unidad hina paqarirqan, qallariypitaq cuartel “Ramón Castilla”-pi tiyarqan. Enero de 1981 killapi conflicto de la Cordillera del Cóndor nisqapi yanaparqan, maqanakuy unidadkunapa ingeniería materialninkunata, equiponkunatapas abastecispa hinallataq waqaychaspa. 1988 watapi órganos logísticos wakmanta kamarisqa kaptin, batallón huch'uyachisqa, kunan Compañía de Ingeniería de Servicios Nº 115-man tikrasqa. 2003 watapi desactivado Batallón de Asuntos Civiles Nº 115-pa personalninta hinallataq mediokunata chaskirqan. Sedenmi Fuerte Militar “Soldado Alfredo Vargas Guerra”, Iquitos distrito, Maynas provincia, Loreto llaqtapi kachkan."
      }
    }
  },
