  "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE": {
    "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE",
    "tipo": "Unidad Orgánica",
    "alias": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "LA AMAZONÍA “SAREGENTO 2do FERNANDO LORES TENAZONA” N° 83 Esta unidad fue conocida históricamente como Batallón de Selva Nº 83, lleva el nombre del Sgto 2do Fernando Lores Tenazoa, héroe peruano inmolado durante el combate de Güepí de 1933.\n\nMediante la RM Nº 560-2025-DE, del 12 de mayo de 2025, adoptó su actual denominación de Batallón de Infantería de Selva de Protección de la Amazonía Nº 83. Su misión comprende la vigilancia de la frontera, la protección territorial y el apoyo a las comunidades asentadas en el extremo nororiental del país.\n\nTiene su sede en Güeppí, distrito de Teniente Manuel Clavero, provincia de Putumayo, región Loreto.",
    "escudo": "/assets/divisiones/escudo_ii_de.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE",
        "resena": "LA AMAZONÍA “SAREGENTO 2do FERNANDO LORES TENAZONA” N° 83 Esta unidad fue conocida históricamente como Batallón de Selva Nº 83, lleva el nombre del Sgto 2do Fernando Lores Tenazoa, héroe peruano inmolado durante el combate de Güepí de 1933.\n\nMediante la RM Nº 560-2025-DE, del 12 de mayo de 2025, adoptó su actual denominación de Batallón de Infantería de Selva de Protección de la Amazonía Nº 83. Su misión comprende la vigilancia de la frontera, la protección territorial y el apoyo a las comunidades asentadas en el extremo nororiental del país.\n\nTiene su sede en Güeppí, distrito de Teniente Manuel Clavero, provincia de Putumayo, región Loreto."
      },
      "en": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE",
        "resena": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE LA AMAZONÍA “SAREGENTO 2do FERNANDO LORES TENAZONA” N° 83 This unit was historically known as Batallón de Selva Nº 83. It is named after Sgto 2do Fernando Lores Tenazoa, a Peruvian hero who sacrificed his life during the combate de Güepí of 1933. By RM Nº 560-2025-DE of May 12, 2025, it adopted its current name, Batallón de Infantería de Selva de Protección de la Amazonía Nº 83. Its mission includes border surveillance, territorial protection, and support for communities located in the country's far northeast. Its headquarters are in Güeppí, distrito de Teniente Manuel Clavero, provincia de Putumayo, región Loreto."
      },
      "qu": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE",
        "resena": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE LA AMAZONÍA “SAREGENTO 2do FERNANDO LORES TENAZONA” N° 83 Kay unidadqa ñawpa pachapi Batallón de Selva Nº 83 sutiyuqmi karqan; Sgto 2do Fernando Lores Tenazoa-pa sutinta apan, payqa combate de Güepí de 1933 nisqapi wañuq Perú qharinmi. RM Nº 560-2025-DE, 12 de mayo de 2025 kamachiywan kunan Batallón de Infantería de Selva de Protección de la Amazonía Nº 83 sutinta chaskirqan. Misiónninmi fronterata qhaway, allpata amachay, Perúpa karu inti lluqsimuy k'uchunpi tiyaq llaqtakunata yanapay. Sedenmi Güeppí, Teniente Manuel Clavero distrito, Putumayo provincia, Loreto suyupi kachkan."
      }
    }
  },
  "compaacomandosaraguron35": {
    "nombre": "COMPAÑÍA COMANDO “SARAGURO” N° 35",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA COMANDO “SARAGURO” N° 35",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Fue organizada para proporcionar apoyo sanitario y veterinario a las unidades de la V División de Ejército desplegadas en la región Loreto. Sus funciones comprenden atención médica inicial, evacuación de heridos, prevención de enfermedades, vigilancia epidemiológica y conservación de la salud animal. Su trayectoria está ligada al sostenimiento de las operaciones militares, acciones cívicas y campañas de salud desarrolladas en la Amazonía peruana.\n\nTiene su sede en el Fuerte Militar “Soldado Alfredo Vargas Guerra”, avenida José Abelardo Quiñones, distrito de Iquitos, provincia de Maynas, Loreto.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO “SARAGURO” N° 35",
        "resena": "Fue organizada para proporcionar apoyo sanitario y veterinario a las unidades de la V División de Ejército desplegadas en la región Loreto. Sus funciones comprenden atención médica inicial, evacuación de heridos, prevención de enfermedades, vigilancia epidemiológica y conservación de la salud animal. Su trayectoria está ligada al sostenimiento de las operaciones militares, acciones cívicas y campañas de salud desarrolladas en la Amazonía peruana.\n\nTiene su sede en el Fuerte Militar “Soldado Alfredo Vargas Guerra”, avenida José Abelardo Quiñones, distrito de Iquitos, provincia de Maynas, Loreto."
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO “SARAGURO” N° 35",
        "resena": "It was organized to provide medical and veterinary support to units of the V División de Ejército deployed in región Loreto. Its functions include initial medical care, casualty evacuation, disease prevention, epidemiological surveillance, and preservation of animal health. Its history is linked to sustaining military operations, civic actions, and health campaigns conducted in the Peruvian Amazonía. Its headquarters are at Fuerte Militar “Soldado Alfredo Vargas Guerra”, avenida José Abelardo Quiñones, distrito de Iquitos, provincia de Maynas, Loreto."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO “SARAGURO” N° 35",
        "resena": "Loreto suyupi mast'arisqa V División de Ejército-pa unidadninkunaman sanidad hinallataq veterinaria yanapayta qunanpaq kamarisqa. Ruwayninkunam qallariy hampiy, k'irisqa runakunata hurquy, unquykunata hark'ay, vigilancia epidemiológica hinallataq uywakunapa qhali kayninta waqaychay. Puririsqanmanta operaciones militares-ta, acciones cívicas-ta, Amazonía peruanapi campañas de salud nisqakunatapas waqaycharqan. Sedenmi Fuerte Militar “Soldado Alfredo Vargas Guerra”, avenida José Abelardo Quiñones, Iquitos distrito, Maynas provincia, Loreto llaqtapi kachkan."
      }
    }
  },
