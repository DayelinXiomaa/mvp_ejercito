  "compaadefuerzasespecialesn22": {
    "nombre": "COMPAÑÍA DE FUERZAS ESPECIALES N° 22",
    "escudo": "/assets/divisiones/slide_603_img_1.png",
    "resena": "ES “SO3 EUSEBIO PESCEROS LUDEÑA” N° 61 La Compañía de Fuerzas Especiales Nº 61, unidad orgánica del Agrupamiento de Ingeniería “Tte Crl Pedro Ruiz Gallo”. Lleva el nombre honorífico del SO3 EP Eugenio Pesceros Ludeña, en reconocimiento a su entrega y sacrificio en cumplimiento del deber. Fue organizada para ejecutar operaciones especiales, reconocimientos, patrullajes y acciones directas en terrenos selváticos de difícil acceso. Su personal ha participado en operaciones contraterroristas y de seguridad contra los remanentes de Sendero Luminoso en el ámbito del VRAEM. Su sede se encuentra en el distrito de Pangoa, provincia de Satipo, región Junín.",
    "page": 603,
    "language": {
      "es": {
        "nombre": "COMPAÑÍA DE FUERZAS ESPECIALES N° 22",
        "resena": "ES “SO3 EUSEBIO PESCEROS LUDEÑA” N° 61 La Compañía de Fuerzas Especiales Nº 61, unidad orgánica del Agrupamiento de Ingeniería “Tte Crl Pedro Ruiz Gallo”. Lleva el nombre honorífico del SO3 EP Eugenio Pesceros Ludeña, en reconocimiento a su entrega y sacrificio en cumplimiento del deber. Fue organizada para ejecutar operaciones especiales, reconocimientos, patrullajes y acciones directas en terrenos selváticos de difícil acceso. Su personal ha participado en operaciones contraterroristas y de seguridad contra los remanentes de Sendero Luminoso en el ámbito del VRAEM. Su sede se encuentra en el distrito de Pangoa, provincia de Satipo, región Junín."
      },
      "en": {
        "nombre": "COMPAÑÍA DE FUERZAS ESPECIALES N° 22",
        "resena": "ES “SO3 EUSEBIO PESCEROS LUDEÑA” N° 61 The Compañía de Fuerzas Especiales Nº 61 is an organic unit of the Agrupamiento de Ingeniería “Tte Crl Pedro Ruiz Gallo”. It bears the honorary name of SO3 EP Eugenio Pesceros Ludeña, in recognition of his dedication and sacrifice in the line of duty. It was organized to conduct special operations, reconnaissance, patrols, and direct actions in difficult-to-access jungle terrain. Its personnel have participated in counterterrorism and security operations against remnants of Sendero Luminoso within the VRAEM. Its headquarters are in distrito de Pangoa, provincia de Satipo, región Junín."
      },
      "qu": {
        "nombre": "COMPAÑÍA DE FUERZAS ESPECIALES N° 22",
        "resena": "ES “SO3 EUSEBIO PESCEROS LUDEÑA” N° 61 Compañía de Fuerzas Especiales Nº 61qa Agrupamiento de Ingeniería “Tte Crl Pedro Ruiz Gallo”-pa ukhunpi kaq unidadmi. SO3 EP Eugenio Pesceros Ludeña-pa yupaychana sutinta apan, deberninta hunt'aspa entregakusqan, sacrificionrayku. Sasa chayanapaq sacha allpakunapi operaciones especiales, reconocimiento, patrullaje hinallataq acción directa nisqakunata ruwananpaq kamarisqa karqan. Soldadonkunan VRAEM suyupi Sendero Luminoso-pa puchuq kallpankunata hark'aq contraterrorista hinallataq seguridad operaciones nisqakunapi yanaparqanku. Sedenmi Pangoa distrito, Satipo provincia, Junín suyupi kachkan."
      }
    }
  },
