  "batallndeingenieradecombaten32": {
    "nombre": "BATALLÓN DE INGENIERÍA DE COMBATE N° 32",
    "tipo": "Unidad Orgánica",
    "alias": "BATALLÓN DE INGENIERÍA DE COMBATE N° 32",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Fue creado mediante la Resolución Suprema N° 005 del 11 de enero de 1999, como unidad orgánica de la 32.ª Brigada de Infantería. Se organizó sobre la base de la Compañía “A” del Batallón de Ingeniería de Combate N° 112. Desde su creación fue destinado a la ciudad de Caraz, debido a la importancia estratégica y geográfica del Callejón de Huaylas. Asimismo, participa en la prevención y atención de aluviones, huaicos, inundaciones y otros desastres recurrentes en la región Áncash. Entre sus intervenciones destaca el despeje y rehabilitación de vías afectadas por un huaico en Caraz, restableciendo la comunicación de las poblaciones damnificadas. En abril de 2025 intervino en la emergencia ocasionada por el aluvión de Huaraz, efectuando trabajos de remoción de escombros y recuperación de vía Mantiene su sede en la ciudad de Caraz, provincia de Huaylas, Áncash.",
    "escudo": "/assets/divisiones/slide_67_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATALLÓN DE INGENIERÍA DE COMBATE N° 32",
        "resena": "Fue creado mediante la Resolución Suprema N° 005 del 11 de enero de 1999, como unidad orgánica de la 32.ª Brigada de Infantería. Se organizó sobre la base de la Compañía “A” del Batallón de Ingeniería de Combate N° 112. Desde su creación fue destinado a la ciudad de Caraz, debido a la importancia estratégica y geográfica del Callejón de Huaylas. Asimismo, participa en la prevención y atención de aluviones, huaicos, inundaciones y otros desastres recurrentes en la región Áncash. Entre sus intervenciones destaca el despeje y rehabilitación de vías afectadas por un huaico en Caraz, restableciendo la comunicación de las poblaciones damnificadas. En abril de 2025 intervino en la emergencia ocasionada por el aluvión de Huaraz, efectuando trabajos de remoción de escombros y recuperación de vía Mantiene su sede en la ciudad de Caraz, provincia de Huaylas, Áncash."
      },
      "en": {
        "nombre": "BATALLÓN DE INGENIERÍA DE COMBATE N° 32",
        "resena": "It was created by Resolución Suprema N° 005 of January 11, 1999, as an organic unit of the 32.ª Brigada de Infantería. It was organized on the basis of Compañía “A” of Batallón de Ingeniería de Combate N° 112. Since its creation, it has been assigned to the city of Caraz because of the strategic and geographic importance of the Callejón de Huaylas. It also participates in the prevention of and response to mudslides, landslides, floods, and other recurring disasters in the Áncash region. Its interventions include clearing and rehabilitating roads affected by a mudslide in Caraz, restoring communication for the affected communities. In April 2025, it responded to the emergency caused by the Huaraz mudslide, carrying out debris-removal and road-recovery work. It maintains its headquarters in the city of Caraz, province of Huaylas, Áncash."
      },
      "qu": {
        "nombre": "BATALLÓN DE INGENIERÍA DE COMBATE N° 32",
        "resena": "Resolución Suprema N° 005 del 11 de enero de 1999 nisqawan 32.ª Brigada de Infanteríapa unidad orgánica-nin hina kamarisqa. Compañía “A” del Batallón de Ingeniería de Combate N° 112 nisqapa patanpi wakichisqa karqan. Kamarisqa kasqanmantapacha ciudad de Carazman churasqa, Callejón de Huaylaspa estratégica y geográfica chanin kayninrayku. Áncash regiónpi aluviones, huaicos, inundaciones hinallataq huk desastres sapa kuti hamuqkunata hark'aypi yanapaypipas llamk'an. Carazpi huk huaicowan waqllisqa ñankunata pichaspa, allinchaspa, ñak'arisqa llaqtakunapa comunicaciónninta kutichirqan. 2025 watapi abril killapi aluvión de Huaraz emergenciapi escombros hurquywan ñan kutichiyta ruwarqan. Sede-ninmi ciudad de Caraz, provincia de Huaylas, Áncash nisqapi kachkan."
      }
    }
  },
