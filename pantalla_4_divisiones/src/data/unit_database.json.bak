  "compaacomandon603": {
    "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 603",
    "escudo": "/assets/divisiones/slide_458_img_1.png",
    "resena": "La Compañía Comando y Servicios Nº 603 es orgánica del Agrupamiento Antitanque «Cazadores» Nº 3 de la III División de Ejército. Fue organizada para proporcionar al comando los medios necesarios para planear, coordinar y conducir las operaciones del Agrupamiento. Instala y protege el puesto de comando, facilitando las comunicaciones, el enlace y el control de las compañías antitanque subordinadas. Asimismo, brinda apoyo administrativo, logístico, sanitario, de mantenimiento. Tiene su sede en Ite, provincia de Jorge Basadre, Tacna.",
    "page": 458,
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 603",
        "resena": "La Compañía Comando y Servicios Nº 603 es orgánica del Agrupamiento Antitanque «Cazadores» Nº 3 de la III División de Ejército. Fue organizada para proporcionar al comando los medios necesarios para planear, coordinar y conducir las operaciones del Agrupamiento. Instala y protege el puesto de comando, facilitando las comunicaciones, el enlace y el control de las compañías antitanque subordinadas. Asimismo, brinda apoyo administrativo, logístico, sanitario, de mantenimiento. Tiene su sede en Ite, provincia de Jorge Basadre, Tacna."
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO N° 603",
        "resena": "The Compañía Comando y Servicios Nº 603 is an organic unit of the Agrupamiento Antitanque «Cazadores» Nº 3 of the III División de Ejército. It was organized to provide the command with the means required to plan, coordinate, and conduct the Agrupamiento's operations. It establishes and protects the command post, facilitating communications, liaison, and control of the subordinate antitank companies. It also provides administrative, logistical, medical, and maintenance support. Its headquarters are in Ite, provincia de Jorge Basadre, Tacna."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO N° 603",
        "resena": "Agrupamiento Antitanque «Cazadores» Nº 3 nisqanpa unidad orgánican. Agrupamiento-pa operaciones planificay, coordinay chaymanta purichinapaq Comando-man necesario runakuna chaymanta medios qunanpaq wakichisqa karqan. Puesto de comando churan chaymanta waqaychan; comunicaciones, enlace chaymanta compañías antitanque subordinadas controlayta yanapan. Hinallataq apoyo administrativo, logístico, sanitario chaymanta mantenimiento qun. Kamachina wasinqa Ite, Jorge Basadre provincia, Tacna llaqtapin kachkan."
      }
    }
  },
  "COMPAÑÍA COMANDO N° 603": {
    "nombre": "COMPAÑÍA COMANDO N° 603",
    "escudo": "/assets/divisiones/slide_458_img_1.png",
    "resena": "La Compañía Comando y Servicios Nº 603 es orgánica del Agrupamiento Antitanque «Cazadores» Nº 3 de la III División de Ejército. Fue organizada para proporcionar al comando los medios necesarios para planear, coordinar y conducir las operaciones del Agrupamiento. Instala y protege el puesto de comando, facilitando las comunicaciones, el enlace y el control de las compañías antitanque subordinadas. Asimismo, brinda apoyo administrativo, logístico, sanitario, de mantenimiento. Tiene su sede en Ite, provincia de Jorge Basadre, Tacna.",
    "page": 458,
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO N° 603",
        "resena": "La Compañía Comando y Servicios Nº 603 es orgánica del Agrupamiento Antitanque «Cazadores» Nº 3 de la III División de Ejército. Fue organizada para proporcionar al comando los medios necesarios para planear, coordinar y conducir las operaciones del Agrupamiento. Instala y protege el puesto de comando, facilitando las comunicaciones, el enlace y el control de las compañías antitanque subordinadas. Asimismo, brinda apoyo administrativo, logístico, sanitario, de mantenimiento. Tiene su sede en Ite, provincia de Jorge Basadre, Tacna."
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO N° 603",
        "resena": "The Compañía Comando y Servicios Nº 603 is an organic unit of the Agrupamiento Antitanque «Cazadores» Nº 3 of the III División de Ejército. It was organized to provide the command with the means required to plan, coordinate, and conduct the Agrupamiento's operations. It establishes and protects the command post, facilitating communications, liaison, and control of the subordinate antitank companies. It also provides administrative, logistical, medical, and maintenance support. Its headquarters are in Ite, provincia de Jorge Basadre, Tacna."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO N° 603",
        "resena": "Agrupamiento Antitanque «Cazadores» Nº 3 nisqanpa unidad orgánican. Agrupamiento-pa operaciones planificay, coordinay chaymanta purichinapaq Comando-man necesario runakuna chaymanta medios qunanpaq wakichisqa karqan. Puesto de comando churan chaymanta waqaychan; comunicaciones, enlace chaymanta compañías antitanque subordinadas controlayta yanapan. Hinallataq apoyo administrativo, logístico, sanitario chaymanta mantenimiento qun. Kamachina wasinqa Ite, Jorge Basadre provincia, Tacna llaqtapin kachkan."
      }
    }
  },
  "agrupamientodecohetesantiareoscrljosgalvezn1": {
    "nombre": "AGRUPAMIENTO DE COHETES ANTIAÉREOS “CRL JOSÉ GALVEZ” N° 1",
    "escudo": "/assets/divisiones/slide_460_img_1.png",
    "resena": "ES ANTIAÉREOS “CRL JOSÉ GÁLVEZ” N° 1 Fue constituida para concentrar unidades de comando, apoyo técnico y cohetes destinadas a la defensa antiaérea del sur peruano. Lleva el nombre del coronel José Gálvez Egúsquiza, héroe y símbolo de la Artillería peruana, caído en el Combate del Dos de Mayo de 1866. Con el tiempo evolucionó hacia el empleo de sistemas de cohetes, comunicaciones y medios técnicos especializados de defensa antiaérea. Es una Gran Unidad especializada de la III División de Ejército, denominada oficialmente Agrupamiento de Cohetes Antiaéreos “Crl José Gálvez” Nº 1. Sus actividades institucionales conmemoran el Combate del Dos de Mayo y el Día del Arma de Artillería. Su sede se encuentra en el Cuartel Pisagua, puerto de Ilo, provincia de Ilo, Moquegua. AGRUPAMIENTO DE COHETES ANTIAÉREOS “CRL JOSE´GALVEZ” GRUPO DE COHETES ANTIAÉREOS N° 2 BATERÍA DE SERVICIOS N° 4 BATERÍA COMANDO Y COMUNICACIONES N° 4 GRUPO TÉCNICO DE COHETES N° 4 GRUPO DE COHETES ANTIAÉREOS N° 4",
    "page": 460,
    "language": {
      "es": {
        "nombre": "AGRUPAMIENTO DE COHETES ANTIAÉREOS “CRL JOSÉ GALVEZ” N° 1",
        "resena": "ES ANTIAÉREOS “CRL JOSÉ GÁLVEZ” N° 1 Fue constituida para concentrar unidades de comando, apoyo técnico y cohetes destinadas a la defensa antiaérea del sur peruano. Lleva el nombre del coronel José Gálvez Egúsquiza, héroe y símbolo de la Artillería peruana, caído en el Combate del Dos de Mayo de 1866. Con el tiempo evolucionó hacia el empleo de sistemas de cohetes, comunicaciones y medios técnicos especializados de defensa antiaérea. Es una Gran Unidad especializada de la III División de Ejército, denominada oficialmente Agrupamiento de Cohetes Antiaéreos “Crl José Gálvez” Nº 1. Sus actividades institucionales conmemoran el Combate del Dos de Mayo y el Día del Arma de Artillería. Su sede se encuentra en el Cuartel Pisagua, puerto de Ilo, provincia de Ilo, Moquegua. AGRUPAMIENTO DE COHETES ANTIAÉREOS “CRL JOSE´GALVEZ” GRUPO DE COHETES ANTIAÉREOS N° 2 BATERÍA DE SERVICIOS N° 4 BATERÍA COMANDO Y COMUNICACIONES N° 4 GRUPO TÉCNICO DE COHETES N° 4 GRUPO DE COHETES ANTIAÉREOS N° 4"
      },
      "en": {
        "nombre": "AGRUPAMIENTO DE COHETES ANTIAÉREOS “CRL JOSÉ GALVEZ” N° 1",
        "resena": "ES ANTIAÉREOS “CRL JOSÉ GÁLVEZ” N° 1 It was constituted to bring together command, technical-support, and rocket units tasked with the air defense of southern Peru. It bears the name of coronel José Gálvez Egúsquiza, a hero and symbol of Peruvian Artillería who was killed in the Combate del Dos de Mayo de 1866. Over time, it evolved toward the employment of rocket systems, communications, and specialized technical air-defense equipment. It is a specialized Gran Unidad of the III División de Ejército, officially designated Agrupamiento de Cohetes Antiaéreos “Crl José Gálvez” Nº 1. Its institutional activities commemorate the Combate del Dos de Mayo and Día del Arma de Artillería. Its headquarters are at Cuartel Pisagua, puerto de Ilo, provincia de Ilo, Moquegua. AGRUPAMIENTO DE COHETES ANTIAÉREOS “CRL JOSE´GALVEZ” GRUPO DE COHETES ANTIAÉREOS N° 2 BATERÍA DE SERVICIOS N° 4 BATERÍA COMANDO Y COMUNICACIONES N° 4 GRUPO TÉCNICO DE COHETES N° 4 GRUPO DE COHETES ANTIAÉREOS N° 4"
      },
      "qu": {
        "nombre": "AGRUPAMIENTO DE COHETES ANTIAÉREOS “CRL JOSÉ GALVEZ” N° 1",
        "resena": "ES ANTIAÉREOS “CRL JOSÉ GÁLVEZ” N° 1 Perúpa surnin antiaérea waqaychayninpaq comando, apoyo técnico chaymanta cohetes unidades nisqakunata huñunanpaqmi kamasqa karqan. Artillería peruana-pa héroen chaymanta unanchaqnin coronel José Gálvez Egúsquiza-pa sutinta apan; payqa Combate del Dos de Mayo de 1866 pachapi wañurqan. Pacha puriyninpi cohetes sistemas, comunicaciones chaymanta defensa antiaérea-pa medios técnicos especializados nisqakunata llamk'achiyta qallariyrqan. III División de Ejército-pa Gran Unidad especializadanmi; oficial sutinqa Agrupamiento de Cohetes Antiaéreos “Crl José Gálvez” Nº 1. Institucional ruwayninkunaqa Combate del Dos de Mayo chaymanta Día del Arma de Artillería nisqakunata yuyarichin. Kamachina wasinqa Cuartel Pisagua, Ilo puerto, Ilo provincia, Moquegua llaqtapin kachkan AGRUPAMIENTO DE COHETES ANTIAÉREOS “CRL JOSE´GALVEZ” GRUPO DE COHETES ANTIAÉREOS N° 2 BATERÍA DE SERVICIOS N° 4 BATERÍA COMANDO Y COMUNICACIONES N° 4 GRUPO TÉCNICO DE COHETES N° 4 GRUPO DE COHETES ANTIAÉREOS N° 4"
      }
    }
  },
