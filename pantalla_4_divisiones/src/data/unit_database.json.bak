  "compaaespecialdecomandosn113": {
    "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS N° 113",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA ESPECIAL DE COMANDOS N° 113",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Especial de Comandos Nº 113 es una unidad de operaciones especiales directamente dependiente de la III División de Ejército. Fue organizada para proporcionar al Comando divisionario una fuerza ligera, flexible y de rápida reacción ante situaciones de elevada complejidad.\n\nSu misión comprende reconocimientos especiales, incursiones, acción directa, rescate y operaciones en apoyo de las grandes unidades del sur. Su personal recibe preparación en combate especial, paracaidismo, patrullaje, supervivencia, demoliciones y operaciones en costa, sierra y selva.\n\nTiene su sede en Arequipa.",
    "escudo": "/assets/divisiones/slide_289_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS N° 113",
        "resena": "La Compañía Especial de Comandos Nº 113 es una unidad de operaciones especiales directamente dependiente de la III División de Ejército. Fue organizada para proporcionar al Comando divisionario una fuerza ligera, flexible y de rápida reacción ante situaciones de elevada complejidad.\n\nSu misión comprende reconocimientos especiales, incursiones, acción directa, rescate y operaciones en apoyo de las grandes unidades del sur. Su personal recibe preparación en combate especial, paracaidismo, patrullaje, supervivencia, demoliciones y operaciones en costa, sierra y selva.\n\nTiene su sede en Arequipa."
      },
      "en": {
        "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS N° 113",
        "resena": "The Compañía Especial de Comandos Nº 113 is a special-operations unit directly subordinate to the III División de Ejército. It was organized to provide the divisional Command with a light, flexible, rapid-reaction force for highly complex situations. Its mission includes special reconnaissance, raids, direct action, rescue, and operations supporting the major units of southern Peru. Its personnel receive training in special combat, parachuting, patrols, survival, demolitions, and operations on the coast, in the highlands, and in the jungle. Its headquarters is in Arequipa."
      },
      "qu": {
        "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS N° 113",
        "resena": "Compañía Especial de Comandos Nº 113qa III División de Ejército-manta chiqalla kamachisqa operaciones especiales unidadmi. Sasa sasachakuykuna kaptin División-pa Comando-ninman mana llasaq, imaymana ruway atiq hinaspa utqay kutichiq kallpata qunapaqmi wakichisqa karqan. Misiónninmi reconocimientos especiales, incursiones, acción directa, rescate chaymanta uraypi grandes unidades yanapayninpi operaciones ruway. Runankunaqa combate especial, paracaidismo, patrullaje, supervivencia, demoliciones chaymanta costa, sierra y selva operaciones nisqapi yachachisqa kanku. Kamachina wasinqa Arequipa llaqtapin kachkan."
      }
    }
  },
