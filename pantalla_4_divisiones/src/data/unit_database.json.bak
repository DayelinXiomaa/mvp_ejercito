  "COMPAÑÍA COMANDO  N° 4": {
    "nombre": "COMPAÑÍA COMANDO  N° 4",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA COMANDO  N° 4",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Comando Nº 4 es una pequeña unidad orgánica y\n\ndirectamente dependiente del Cuartel General de la 4ª Brigada de\n\nMontaña.\n\nFue organizada para proporcionar seguridad, apoyo administrativo y\n\nfacilidades de funcionamiento al Comando y Estado Mayor de la Brigada.\n\nSu misión comprende instalar y proteger el puesto de comando, atender\n\nel servicio interno y apoyar las actividades de comando y control.\n\nTiene su sede en el Cuartel Inca Manco Cápac de Puno.",
    "escudo": "/assets/divisiones/slide_381_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO  N° 4",
        "resena": "La Compañía Comando Nº 4 es una pequeña unidad orgánica y\n\ndirectamente dependiente del Cuartel General de la 4ª Brigada de\n\nMontaña.\n\nFue organizada para proporcionar seguridad, apoyo administrativo y\n\nfacilidades de funcionamiento al Comando y Estado Mayor de la Brigada.\n\nSu misión comprende instalar y proteger el puesto de comando, atender\n\nel servicio interno y apoyar las actividades de comando y control.\n\nTiene su sede en el Cuartel Inca Manco Cápac de Puno."
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO  N° 4",
        "resena": "The Compañía Comando Nº 4 is a small organic unit directly subordinate to the Cuartel General of the 4ª Brigada de Montaña.\n\nIt was organized to provide security, administrative support, and operational facilities for the Brigade Command and Staff.\n\nIts mission includes establishing and protecting the command post, providing internal services, and supporting command-and-control activities.\n\nIts headquarters are at Cuartel Inca Manco Cápac in Puno."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO  N° 4",
        "resena": "Compañía Comando Nº 4qa Cuartel General de la 4ª Brigada de Montaña-manta chiqalla kamachisqa huch'uy unidad orgánican.\n\nBrigada-pa Comando chaymanta Estado Mayor-ninman seguridad, administración yanapay hinaspa llamk'ananpaq facilidades quyta ruwanapaqmi wakichisqa karqan.\n\nMisiónninmi puesto de comando churay hinaspa amachay, servicio interno qhawariy chaymanta comando y control ruraykunata yanapay.\n\nKamachina wasinqa Cuartel Inca Manco Cápac, Puno llaqtapin kachkan."
      }
    }
  },
  "COMPAÑÍA POLICÍA MILITAR  N° 4": {
    "nombre": "COMPAÑÍA POLICÍA MILITAR  N° 4",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA POLICÍA MILITAR  N° 4",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía de Policía Militar Nº 4 es una pequeña unidad orgánica y\n\ndirectamente dependiente de la 4ª Brigada de Montaña.\n\nFue organizada para mantener la disciplina, el orden y la seguridad en\n\nlas instalaciones y áreas bajo responsabilidad de la Brigada.\n\nSu misión comprende el control de accesos, protección de autoridades,\n\ncustodia de instalaciones y regulación del tránsito militar.\n\nTiene su sede en Puno.",
    "escudo": "/assets/divisiones/slide_383_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR  N° 4",
        "resena": "La Compañía de Policía Militar Nº 4 es una pequeña unidad orgánica y\n\ndirectamente dependiente de la 4ª Brigada de Montaña.\n\nFue organizada para mantener la disciplina, el orden y la seguridad en\n\nlas instalaciones y áreas bajo responsabilidad de la Brigada.\n\nSu misión comprende el control de accesos, protección de autoridades,\n\ncustodia de instalaciones y regulación del tránsito militar.\n\nTiene su sede en Puno."
      },
      "en": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR  N° 4",
        "resena": "The Compañía de Policía Militar Nº 4 is a small organic unit directly subordinate to the 4ª Brigada de Montaña.\n\nIt was organized to maintain discipline, order, and security in the facilities and areas under the Brigade’s responsibility.\n\nIts mission includes access control, protection of authorities, security of facilities, and regulation of military traffic.\n\nIts headquarters are in Puno."
      },
      "qu": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR  N° 4",
        "resena": "Compañía de Policía Militar Nº 4qa 4ª Brigada de Montaña-manta chiqalla kamachisqa huch'uy unidad orgánican.\n\nBrigada-pa kamachiyninpi instalaciones chaymanta kitikuna ukhupi disciplina, orden hinaspa seguridad waqaychanapaqmi wakichisqa karqan.\n\nMisiónninmi yaykuy kamachiy, autoridades amachay, instalaciones waqaychay chaymanta tránsito militar kamachiy.\n\nKamachina wasinqa Puno llaqtapin kachkan."
      }
    }
  },
