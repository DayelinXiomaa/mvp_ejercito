  "compaapolicamilitarn211": {
    "nombre": "COMPAÑÍA POLICÍA MILITAR N° 211",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA POLICÍA MILITAR N° 211",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía de Policía Militar Nº 211 fue organizada como pequeña unidad de seguridad de la 9ª Brigada Blindada. Su misión comprende mantener el orden y la disciplina, controlar el tránsito militar y resguardar las instalaciones de la Gran Unidad. También proporciona seguridad al comandante, Estado Mayor, puestos de comando y autoridades militares durante ceremonias y operaciones. Ha acompañado los despliegues y ejercicios de la brigada en la frontera norte. Es orgánica de la 9ª Brigada Blindada y tiene su sede en el Fuerte 24 de Julio, sector El Tablazo, Tumbes.",
    "escudo": "/assets/divisiones/slide_96_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 211",
        "resena": "La Compañía de Policía Militar Nº 211 fue organizada como pequeña unidad de seguridad de la 9ª Brigada Blindada. Su misión comprende mantener el orden y la disciplina, controlar el tránsito militar y resguardar las instalaciones de la Gran Unidad. También proporciona seguridad al comandante, Estado Mayor, puestos de comando y autoridades militares durante ceremonias y operaciones. Ha acompañado los despliegues y ejercicios de la brigada en la frontera norte. Es orgánica de la 9ª Brigada Blindada y tiene su sede en el Fuerte 24 de Julio, sector El Tablazo, Tumbes."
      },
      "en": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 211",
        "resena": "Compañía de Policía Militar Nº 211 was organized as a small security unit of the 9ª Brigada Blindada. Its mission includes maintaining order and discipline, controlling military traffic, and safeguarding the facilities of the Gran Unidad. It also provides security for the commander, Staff, command posts, and military authorities during ceremonies and operations. It has accompanied the brigade’s deployments and exercises on the northern border. It is an organic unit of the 9ª Brigada Blindada and is based at Fuerte 24 de Julio, sector El Tablazo, Tumbes."
      },
      "qu": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR N° 211",
        "resena": "Compañía de Policía Militar Nº 211 nisqaqa 9ª Brigada Blindadapa pequeña unidad de seguridad-nin hina wakichisqa karqan. Misión-ninmi ordenwan disciplinata waqaychay, tránsito militarta controlay, Gran Unidadpa instalacionesninta amachay. Comandante, Estado Mayor, puestos de comando hinallataq autoridades militares nisqakunaman ceremoniaswan operaciones pachapi seguridadta qun. Frontera nortepi brigadapa desplieguesninwan ejerciciosninwan kuska purirqan. 9ª Brigada Blindadapa unidad orgánica-ninmi; sede-ninmi Fuerte 24 de Julio, sector El Tablazo, Tumbes nisqapi kachkan."
      }
    }
  },
