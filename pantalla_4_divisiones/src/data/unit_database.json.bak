  "batallndecomunicacionessgtomayorbenitopardofigueroan115": {
    "nombre": "BATALLÓN DE COMUNICACIONES “ SGTO MAYOR BENITO PARDO FIGUEROA” N° 115",
    "tipo": "Unidad Orgánica",
    "alias": "BATALLÓN DE COMUNICACIONES “ SGTO MAYOR BENITO PARDO FIGUEROA” N° 115",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Su antecedente fue la Sección de Transmisiones Nº 5, creada en 1944 como parte del Servicio de Transmisiones de la entonces División de Selva. En 1959 se transformó en Compañía de Transmisiones Nº 5, denominación que conservó hasta diciembre de 1974.\n\nMediante Decreto Supremo Nº 107-74-GU/DIRODIN del 18 de noviembre de 1974 se creó el Batallón de Transmisiones Nº 115, activado el 1 de enero de 1975. El 26 de junio de 1979 adoptó su actual denominación de Batallón de Comunicaciones “Sargento Mayor Benito Pardo Figueroa” N.º 115. La unidad proporcionó enlaces durante las operaciones de la cordillera del Cóndor y del Alto Cenepa.\n\nTiene su sede en el cuartel “Sargento Mayor Benito Pardo Figueroa”, en Iquitos.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATALLÓN DE COMUNICACIONES “ SGTO MAYOR BENITO PARDO FIGUEROA” N° 115",
        "resena": "Su antecedente fue la Sección de Transmisiones Nº 5, creada en 1944 como parte del Servicio de Transmisiones de la entonces División de Selva. En 1959 se transformó en Compañía de Transmisiones Nº 5, denominación que conservó hasta diciembre de 1974.\n\nMediante Decreto Supremo Nº 107-74-GU/DIRODIN del 18 de noviembre de 1974 se creó el Batallón de Transmisiones Nº 115, activado el 1 de enero de 1975. El 26 de junio de 1979 adoptó su actual denominación de Batallón de Comunicaciones “Sargento Mayor Benito Pardo Figueroa” N.º 115. La unidad proporcionó enlaces durante las operaciones de la cordillera del Cóndor y del Alto Cenepa.\n\nTiene su sede en el cuartel “Sargento Mayor Benito Pardo Figueroa”, en Iquitos."
      },
      "en": {
        "nombre": "BATALLÓN DE COMUNICACIONES “ SGTO MAYOR BENITO PARDO FIGUEROA” N° 115",
        "resena": "Its predecessor was Sección de Transmisiones Nº 5, created in 1944 as part of the Servicio de Transmisiones of the former División de Selva. In 1959, it became Compañía de Transmisiones Nº 5, a name it retained until December 1974. By Decreto Supremo Nº 107-74-GU/DIRODIN of November 18, 1974, Batallón de Transmisiones Nº 115 was created and activated on January 1, 1975. On June 26, 1979, it adopted its current name, Batallón de Comunicaciones “Sargento Mayor Benito Pardo Figueroa” N.º 115. The unit provided communications during the operaciones de la cordillera del Cóndor and del Alto Cenepa. Its headquarters are at cuartel “Sargento Mayor Benito Pardo Figueroa”, in Iquitos."
      },
      "qu": {
        "nombre": "BATALLÓN DE COMUNICACIONES “ SGTO MAYOR BENITO PARDO FIGUEROA” N° 115",
        "resena": "Ñawpaqninmi 1944 watapi División de Selva-pa Servicio de Transmisiones ukhunpi paqarisqa Sección de Transmisiones Nº 5 karqan. 1959 watapi Compañía de Transmisiones Nº 5-man tikrasqa, diciembre de 1974 killakama chay sutiyuq. Decreto Supremo Nº 107-74-GU/DIRODIN, 18 de noviembre de 1974 kamachiywan Batallón de Transmisiones Nº 115 paqarichisqa, 1 de enero de 1975 p'unchawtaq llamk'ayta qallariq. 26 de junio de 1979 p'unchawmi kunan Batallón de Comunicaciones “Sargento Mayor Benito Pardo Figueroa” N.º 115 sutinta chaskirqan. Cordillera del Cóndor hinallataq Alto Cenepa operaciones nisqakunapi comunicaciones t'inkiyta qarqan. Sedenmi cuartel “Sargento Mayor Benito Pardo Figueroa”, Iquitos llaqtapi kachkan."
      }
    }
  },
