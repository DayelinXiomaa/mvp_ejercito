  "batallndeinfanteradeselvadeproteccinalaamazonapiuran32": {
    "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32",
    "tipo": "Unidad Orgánica",
    "alias": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Batallón orgánico de la 1ª Brigada de Selva de Protección de la Amazonía, antigua 6ª Brigada de Selva, bajo la I División de Ejército. Fue organizado y entrenado para ejecutar operaciones descentralizadas de vigilancia, reconocimiento y combate en el difícil escenario selvático amazónico. El batallón tubo participación durante el conflicto del Cenepa de 1995, Después del conflicto continuó protegiendo la frontera peruano-ecuatoriana mediante patrullajes terrestres y fluviales, especialmente en sectores de difícil acceso.\n\nSu sede actual se encuentra en la guarnición de Ciro Alegría, distrito de Nieva, provincia de Condorcanqui, región Amazonas.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32",
        "resena": "Batallón orgánico de la 1ª Brigada de Selva de Protección de la Amazonía, antigua 6ª Brigada de Selva, bajo la I División de Ejército. Fue organizado y entrenado para ejecutar operaciones descentralizadas de vigilancia, reconocimiento y combate en el difícil escenario selvático amazónico. El batallón tubo participación durante el conflicto del Cenepa de 1995, Después del conflicto continuó protegiendo la frontera peruano-ecuatoriana mediante patrullajes terrestres y fluviales, especialmente en sectores de difícil acceso.\n\nSu sede actual se encuentra en la guarnición de Ciro Alegría, distrito de Nieva, provincia de Condorcanqui, región Amazonas."
      },
      "en": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32",
        "resena": "An organic battalion of the 1ª Brigada de Selva de Protección de la Amazonía, formerly the 6ª Brigada de Selva, under the I División de Ejército. It was organized and trained to conduct decentralized surveillance, reconnaissance, and combat operations in the challenging Amazon jungle environment. The battalion participated in the 1995 Conflicto del Cenepa. After the conflict, it continued to protect the Peruvian–Ecuadorian border through land and river patrols, particularly in hard-to-reach sectors. Its current headquarters is at the Ciro Alegría garrison, district of Nieva, province of Condorcanqui, Amazonas region."
      },
      "qu": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32",
        "resena": "1ª Brigada de Selva de Protección de la Amazonía nisqapa batallón orgánico-ninmi; ñawpaqtaqa 6ª Brigada de Selva karqan, I División de Ejército nisqapa kamachiyninpi. Amazonas selvapa sasa pampanpi vigilancia, reconocimiento hinallataq combate nisqa operaciones descentralizadas ruwanapaq wakichisqa, yachachisqataq karqan. Batallónmi 1995 watapi Conflicto del Cenepapi yanaparqan. Chay conflicto qhipamanpas frontera peruano-ecuatorianata allpanta mayuntinta patrullaspa waqaychallarqan, aswanqa mana chayay atina sectorakunapi. Kunan sede-ninmi guarnición de Ciro Alegría, distrito de Nieva, provincia de Condorcanqui, región Amazonas nisqapi kachkan."
      }
    }
  },
  "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32": {
    "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32",
    "tipo": "Unidad Orgánica",
    "alias": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Batallón orgánico de la 1ª Brigada de Selva de Protección de la Amazonía, antigua 6ª Brigada de Selva, bajo la I División de Ejército. Fue organizado y entrenado para ejecutar operaciones descentralizadas de vigilancia, reconocimiento y combate en el difícil escenario selvático amazónico. El batallón tubo participación durante el conflicto del Cenepa de 1995, Después del conflicto continuó protegiendo la frontera peruano-ecuatoriana mediante patrullajes terrestres y fluviales, especialmente en sectores de difícil acceso.\n\nSu sede actual se encuentra en la guarnición de Ciro Alegría, distrito de Nieva, provincia de Condorcanqui, región Amazonas.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32",
        "resena": "Batallón orgánico de la 1ª Brigada de Selva de Protección de la Amazonía, antigua 6ª Brigada de Selva, bajo la I División de Ejército. Fue organizado y entrenado para ejecutar operaciones descentralizadas de vigilancia, reconocimiento y combate en el difícil escenario selvático amazónico. El batallón tubo participación durante el conflicto del Cenepa de 1995, Después del conflicto continuó protegiendo la frontera peruano-ecuatoriana mediante patrullajes terrestres y fluviales, especialmente en sectores de difícil acceso.\n\nSu sede actual se encuentra en la guarnición de Ciro Alegría, distrito de Nieva, provincia de Condorcanqui, región Amazonas."
      },
      "en": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32",
        "resena": "An organic battalion of the 1ª Brigada de Selva de Protección de la Amazonía, formerly the 6ª Brigada de Selva, under the I División de Ejército. It was organized and trained to conduct decentralized surveillance, reconnaissance, and combat operations in the challenging Amazon jungle environment. The battalion participated in the 1995 Conflicto del Cenepa. After the conflict, it continued to protect the Peruvian–Ecuadorian border through land and river patrols, particularly in hard-to-reach sectors. Its current headquarters is at the Ciro Alegría garrison, district of Nieva, province of Condorcanqui, Amazonas region."
      },
      "qu": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN A LA AMAZONÍA “PIURA” N° 32",
        "resena": "1ª Brigada de Selva de Protección de la Amazonía nisqapa batallón orgánico-ninmi; ñawpaqtaqa 6ª Brigada de Selva karqan, I División de Ejército nisqapa kamachiyninpi. Amazonas selvapa sasa pampanpi vigilancia, reconocimiento hinallataq combate nisqa operaciones descentralizadas ruwanapaq wakichisqa, yachachisqataq karqan. Batallónmi 1995 watapi Conflicto del Cenepapi yanaparqan. Chay conflicto qhipamanpas frontera peruano-ecuatorianata allpanta mayuntinta patrullaspa waqaychallarqan, aswanqa mana chayay atina sectorakunapi. Kunan sede-ninmi guarnición de Ciro Alegría, distrito de Nieva, provincia de Condorcanqui, región Amazonas nisqapi kachkan."
      }
    }
  },
  "batallndeinfanteradeselvadeproteccindelaamazonasargento1demetrioacostachuezn85": {
    "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE LA AMAZONÍA “ SARGENTO 1° DEMETRIO ACOSTA CHUEZ N° 85",
    "tipo": "Unidad Orgánica",
    "alias": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE LA AMAZONÍA “ SARGENTO 1° DEMETRIO ACOSTA CHUEZ N° 85",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "El Batallón de Infantería de Selva de Protección de la Amazonía N° 85 tiene su presencia en Ampama desde antes de 1991. Fue organizada para proteger la frontera nororiental mediante operaciones terrestres, fluviales y aeromóviles en la cuenca del río Santiago.\n\nDurante el conflicto del Cenepa de 1995, defendió los puestos de vigilancia Cahuide, Chiqueiza, Pachacútec y otros sectores próximos a la Cordillera del Cóndor. Sus patrullas sostuvieron enfrentamientos en el sector del río Santiago, cumpliendo misiones de reconocimiento, defensa de posiciones y protección de la soberanía nacional.\n\nSu sede se encuentra en la guarnición de Ampama, distrito de Río Santiago, provincia de Condorcanqui, región Amazonas.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE LA AMAZONÍA “ SARGENTO 1° DEMETRIO ACOSTA CHUEZ N° 85",
        "resena": "El Batallón de Infantería de Selva de Protección de la Amazonía N° 85 tiene su presencia en Ampama desde antes de 1991. Fue organizada para proteger la frontera nororiental mediante operaciones terrestres, fluviales y aeromóviles en la cuenca del río Santiago.\n\nDurante el conflicto del Cenepa de 1995, defendió los puestos de vigilancia Cahuide, Chiqueiza, Pachacútec y otros sectores próximos a la Cordillera del Cóndor. Sus patrullas sostuvieron enfrentamientos en el sector del río Santiago, cumpliendo misiones de reconocimiento, defensa de posiciones y protección de la soberanía nacional.\n\nSu sede se encuentra en la guarnición de Ampama, distrito de Río Santiago, provincia de Condorcanqui, región Amazonas."
      },
      "en": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE LA AMAZONÍA “ SARGENTO 1° DEMETRIO ACOSTA CHUEZ N° 85",
        "resena": "The Batallón de Infantería de Selva de Protección de la Amazonía N° 85 has maintained a presence in Ampama since before 1991. It was organized to protect the northeastern border through land, riverine, and airmobile operations in the río Santiago basin. During the 1995 Conflicto del Cenepa, it defended the Cahuide, Chiqueiza, and Pachacútec surveillance posts and other sectors near the Cordillera del Cóndor. Its patrols engaged in combat in the río Santiago sector, carrying out reconnaissance, position-defense, and national-sovereignty protection missions. Its headquarters is at the Ampama garrison, district of Río Santiago, province of Condorcanqui, Amazonas region."
      },
      "qu": {
        "nombre": "BATALLÓN DE INFANTERÍA DE SELVA DE PROTECCIÓN DE LA AMAZONÍA “ SARGENTO 1° DEMETRIO ACOSTA CHUEZ N° 85",
        "resena": "Batallón de Infantería de Selva de Protección de la Amazonía N° 85 nisqaqa 1991 watapa ñawpaqninmantapacha Ampamapi kachkan. Frontera nororientalta waqaychananpaqmi allpapi, mayupi hinallataq aeromóvil operaciones ruwanapaq, río Santiagopa cuencanpi wakichisqa karqan. 1995 watapi Conflicto del Cenepapi, puestos de vigilancia Cahuide, Chiqueiza, Pachacútec hinallataq Cordillera del Cóndorpa qayllanpi kaq huk sectorakunata amacharqan. Patrullasninkuna río Santiago sectorpi maqanakurqanku, reconocimiento, posiciones amachay hinallataq soberanía nacional waqaychay misioneskunata hunt'aspa. Sede-ninmi guarnición de Ampama, distrito de Río Santiago, provincia de Condorcanqui, región Amazonas nisqapi kachkan."
      }
    }
  },
