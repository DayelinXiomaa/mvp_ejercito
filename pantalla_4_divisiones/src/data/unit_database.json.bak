  "COMPAÑÍA COMANDO  N° 3": {
    "nombre": "COMPAÑÍA COMANDO  N° 3",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA COMANDO  N° 3",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Comando Nº 3 es una pequeña unidad orgánica y\n\ndirectamente dependiente del Cuartel General de la 3ª Brigada Blindada.\n\nFue organizada para proporcionar seguridad, apoyo administrativo y\n\nfacilidades de funcionamiento al Comando y Estado Mayor de la Brigada.\n\nSu misión comprende la instalación y protección del puesto de comando,\n\nel servicio interno y el apoyo a las actividades de comando y control.\n\nTiene su sede en Moquegua.",
    "escudo": "/assets/divisiones/slide_306_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO  N° 3",
        "resena": "La Compañía Comando Nº 3 es una pequeña unidad orgánica y\n\ndirectamente dependiente del Cuartel General de la 3ª Brigada Blindada.\n\nFue organizada para proporcionar seguridad, apoyo administrativo y\n\nfacilidades de funcionamiento al Comando y Estado Mayor de la Brigada.\n\nSu misión comprende la instalación y protección del puesto de comando,\n\nel servicio interno y el apoyo a las actividades de comando y control.\n\nTiene su sede en Moquegua."
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO  N° 3",
        "resena": "The Compañía Comando Nº 3 is a small organic unit directly subordinate to the headquarters of the 3ª Brigada Blindada.\n\nIt was organized to provide security, administrative support, and operating facilities to the brigade Command and Staff.\n\nIts mission includes establishing and protecting the command post, internal services, and support for command-and-control activities.\n\nIts headquarters is in Moquegua."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO  N° 3",
        "resena": "Compañía Comando Nº 3qa Cuartel General de la 3ª Brigada Blindada-manta chiqalla kamachisqa huch'uy unidad orgánican.\n\nBrigada-pa Comando chaymanta Estado Mayor-ninman seguridad, administración yanapay hinaspa llamk'ananpaq facilidades quyta ruwanapaqmi wakichisqa karqan.\n\nMisiónninmi puesto de comando churay hinaspa amachay, servicio interno chaymanta comando y control ruraykunata yanapay.\n\nKamachina wasinqa Moquegua llaqtapin kachkan."
      }
    }
  },
  "COMPAÑÍA POLICÍA MILITAR  N° 3": {
    "nombre": "COMPAÑÍA POLICÍA MILITAR  N° 3",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA POLICÍA MILITAR  N° 3",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía de Policía Militar Nº 3 es una pequeña unidad orgánica y\n\ndirectamente dependiente de la 3ª Brigada Blindada.\n\nFue organizada para mantener la disciplina, el orden y la seguridad\n\ndentro de las instalaciones y áreas bajo responsabilidad de la Brigada.\n\nSu misión comprende el control de accesos, protección de autoridades,\n\ncustodia de instalaciones y regulación del tránsito militar.\n\nTiene su sede en Moquegua.",
    "escudo": "/assets/divisiones/slide_308_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR  N° 3",
        "resena": "La Compañía de Policía Militar Nº 3 es una pequeña unidad orgánica y\n\ndirectamente dependiente de la 3ª Brigada Blindada.\n\nFue organizada para mantener la disciplina, el orden y la seguridad\n\ndentro de las instalaciones y áreas bajo responsabilidad de la Brigada.\n\nSu misión comprende el control de accesos, protección de autoridades,\n\ncustodia de instalaciones y regulación del tránsito militar.\n\nTiene su sede en Moquegua."
      },
      "en": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR  N° 3",
        "resena": "The Compañía de Policía Militar Nº 3 is a small organic unit directly subordinate to the 3ª Brigada Blindada.\n\nIt was organized to maintain discipline, order, and security within the brigade’s facilities and areas of responsibility.\n\nIts mission includes access control, protection of authorities, safeguarding facilities, and regulation of military traffic.\n\nIts headquarters is in Moquegua."
      },
      "qu": {
        "nombre": "COMPAÑÍA POLICÍA MILITAR  N° 3",
        "resena": "Compañía de Policía Militar Nº 3qa 3ª Brigada Blindada-manta chiqalla kamachisqa huch'uy unidad orgánican.\n\nBrigada-pa kamachiyninpi instalaciones chaymanta kitikuna ukhupi disciplina, orden hinaspa seguridad waqaychanapaqmi wakichisqa karqan.\n\nMisiónninmi yaykuy kamachiy, autoridades amachay, instalaciones waqaychay chaymanta tránsito militar kamachiy.\n\nKamachina wasinqa Moquegua llaqtapin kachkan."
      }
