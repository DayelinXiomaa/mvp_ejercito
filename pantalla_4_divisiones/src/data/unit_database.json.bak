  "bateradeservicioscapjhonyvalderramapradon4": {
    "nombre": "BATERÍA DE SERVICIOS “CAP JHONY VALDERRAMA PRADO” N° 4",
    "tipo": "Unidad Orgánica",
    "alias": "BATERÍA DE SERVICIOS “CAP JHONY VALDERRAMA PRADO” N° 4",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Batería de Servicios Nº 4, fue organizada para sostener las operaciones de los grupos de cohetes, la unidad técnica y los elementos de comando del Agrupamiento. Cumple funciones de abastecimiento, transporte, alimentación, sanidad, mantenimiento, recuperación de material y servicios administrativos. Su labor permite conservar la operatividad de los sistemas antiaéreos, vehículos, equipos técnicos y demás medios empleados por la fuerza.\n\nTiene su sede en el Cuartel Pisagua, Ilo, departamento de Moquegua.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATERÍA DE SERVICIOS “CAP JHONY VALDERRAMA PRADO” N° 4",
        "resena": "La Batería de Servicios Nº 4, fue organizada para sostener las operaciones de los grupos de cohetes, la unidad técnica y los elementos de comando del Agrupamiento. Cumple funciones de abastecimiento, transporte, alimentación, sanidad, mantenimiento, recuperación de material y servicios administrativos. Su labor permite conservar la operatividad de los sistemas antiaéreos, vehículos, equipos técnicos y demás medios empleados por la fuerza.\n\nTiene su sede en el Cuartel Pisagua, Ilo, departamento de Moquegua."
      },
      "en": {
        "nombre": "BATERÍA DE SERVICIOS “CAP JHONY VALDERRAMA PRADO” N° 4",
        "resena": "The Batería de Servicios Nº 4 was organized to sustain the operations of the rocket groups, technical unit, and command elements of the Agrupamiento. It performs supply, transportation, food service, medical support, maintenance, equipment recovery, and administrative-service functions. Its work maintains the operational readiness of the antiaircraft systems, vehicles, technical equipment, and other resources employed by the force. Its headquarters are at Cuartel Pisagua, Ilo, departamento de Moquegua."
      },
      "qu": {
        "nombre": "BATERÍA DE SERVICIOS “CAP JHONY VALDERRAMA PRADO” N° 4",
        "resena": "Batería de Servicios Nº 4, Agrupamiento-pa grupos de cohetes, unidad técnica chaymanta elementos de comando del Agrupamiento-ninta yanapananpaq wakichisqa karqan. Abastecimiento, transporte, alimentación, sanidad, mantenimiento, material recuperación chaymanta servicios administrativos ruwaykunata hunt'an. Llamk'ayninwan sistemas antiaéreos, vehículos, equipos técnicos chaymanta fuerza-pa wak medios-nin llamk'aqlla kanku. Kamachina wasinqa Cuartel Pisagua, Ilo, Moquegua departamentopin kachkan."
      }
    }
  },
