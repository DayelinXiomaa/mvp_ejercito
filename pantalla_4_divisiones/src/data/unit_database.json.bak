  "compaacomandoyserviciosn22": {
    "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 22",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA COMANDO Y SERVICIOS N° 22",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Comando y Servicios Nº 22 es una pequeña unidad orgánica del Agrupamiento de Ingeniería “T eniente Coronel Pedro Ruiz Gallo”, fue organizada para brindar apoyo al comandante, Estado Mayor y Cuartel General, asegurando el funcionamiento administrativo y logístico del agrupamiento. Cumple tareas de seguridad, transporte, abastecimiento, mantenimiento, sanidad y sostenimiento de las unidades de ingeniería subordinadas. Ha apoyado las operaciones contraterroristas y los trabajos de ingeniería desarrollados por el agrupamiento en la selva central y el VRAEM.\n\nSu sede se encuentra en el distrito de Villa Rica, provincia de Oxapampa, región Pasco",
    "escudo": "/assets/divisiones/slide_601_img_1.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 22",
        "resena": "La Compañía Comando y Servicios Nº 22 es una pequeña unidad orgánica del Agrupamiento de Ingeniería “T eniente Coronel Pedro Ruiz Gallo”, fue organizada para brindar apoyo al comandante, Estado Mayor y Cuartel General, asegurando el funcionamiento administrativo y logístico del agrupamiento. Cumple tareas de seguridad, transporte, abastecimiento, mantenimiento, sanidad y sostenimiento de las unidades de ingeniería subordinadas. Ha apoyado las operaciones contraterroristas y los trabajos de ingeniería desarrollados por el agrupamiento en la selva central y el VRAEM.\n\nSu sede se encuentra en el distrito de Villa Rica, provincia de Oxapampa, región Pasco"
      },
      "en": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 22",
        "resena": "The Compañía Comando y Servicios Nº 22 is a small organic unit of the Agrupamiento de Ingeniería “Teniente Coronel Pedro Ruiz Gallo”. It was organized to support the commander, Estado Mayor, and Cuartel General, ensuring the Agrupamiento's administrative and logistical operation. It performs security, transportation, supply, maintenance, medical, and sustainment tasks for subordinate engineering units. It has supported counterterrorism operations and engineering works conducted by the Agrupamiento in the central jungle and the VRAEM. Its headquarters are in distrito de Villa Rica, provincia de Oxapampa, región Pasco."
      },
      "qu": {
        "nombre": "COMPAÑÍA COMANDO Y SERVICIOS N° 22",
        "resena": "Compañía Comando y Servicios Nº 22qa Agrupamiento de Ingeniería “Teniente Coronel Pedro Ruiz Gallo”-pa ukhunpi kaq huch'uy unidadmi. Comandanteta, Estado Mayorta, Cuartel Generaltapas yanapananpaq kamarisqa; agrupamientopa administración hinallataq logística llamk'ayninta allin purichin. Seguridad, transporte, abastecimiento, mantenimiento, sanidad hinallataq uraypi kaq ingeniería unidadkunapa sostenimiento llamk'aykunata hunt'an. Selva centralpi VRAEM suyupipas agrupamientopa contraterrorista operacionesninta, ingeniería llamk'aynintapas yanaparqan. Sedenmi Villa Rica distrito, Oxapampa provincia, Pasco suyupi kachkan."
      }
    }
  },
