  "compaaespecialdecomandospachacutecn31": {
    "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Especial de Comandos «Pachacútec» Nº 31, es una pequeña unidad orgánica de la 31ª Brigada de Infantería. Tiene su actividad operacional desde comienzos de la década de 1990. Fue organizada para ejecutar operaciones especiales, reconocimiento, acción directa y lucha contraterrorista en la selva central y el VRAEM. Ha participado activamente en el proceso de pacificación nacional, operando en zonas de Pichanaki, Villa Rica, Satipo, Pangoa y Vizcatán del Ene. El 25 de junio de 2019 perdió a tres integrantes durante operaciones de reconocimiento y combate cerca de Valle Manantial, en el VRAEM.\n\nSu sede actual se encuentra en San Antonio de Sonomoro, distrito de Pangoa, provincia de Satipo, Junín.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31",
        "resena": "La Compañía Especial de Comandos «Pachacútec» Nº 31, es una pequeña unidad orgánica de la 31ª Brigada de Infantería. Tiene su actividad operacional desde comienzos de la década de 1990. Fue organizada para ejecutar operaciones especiales, reconocimiento, acción directa y lucha contraterrorista en la selva central y el VRAEM. Ha participado activamente en el proceso de pacificación nacional, operando en zonas de Pichanaki, Villa Rica, Satipo, Pangoa y Vizcatán del Ene. El 25 de junio de 2019 perdió a tres integrantes durante operaciones de reconocimiento y combate cerca de Valle Manantial, en el VRAEM.\n\nSu sede actual se encuentra en San Antonio de Sonomoro, distrito de Pangoa, provincia de Satipo, Junín."
      },
      "en": {
        "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31",
        "resena": "The Compañía Especial de Comandos «Pachacútec» Nº 31 is a small organic unit of the 31ª Brigada de Infantería. It has been operational since the early 1990s. It was organized to conduct special operations, reconnaissance, direct action, and counterterrorism in the central jungle and the VRAEM. It has actively participated in the national pacification process, operating in Pichanaki, Villa Rica, Satipo, Pangoa, and Vizcatán del Ene. On June 25, 2019, it lost three members during reconnaissance and combat operations near Valle Manantial, in the VRAEM. Its current headquarters are in San Antonio de Sonomoro, distrito de Pangoa, provincia de Satipo, Junín."
      },
      "qu": {
        "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31",
        "resena": "Compañía Especial de Comandos «Pachacútec» Nº 31qa 31ª Brigada de Infantería-pa pequeña unidad orgánican. 1990 watakunapa qallariyninmantapacha operaciones ruwan. Selva central chaymanta VRAEM nisqapi operaciones especiales, reconocimiento, acción directa y lucha contraterrorista ruwanapaq wakichisqa karqan. Pacificación nacionalpi Pichanaki, Villa Rica, Satipo, Pangoa y Vizcatán del Ene kitikunapi ancha yanaparqan. 25 junio 2019 p'unchaw VRAEM nisqapi Valle Manantial qayllapi reconocimiento chaymanta combate operaciones ruwachkaptin kimsa runanta chinkachirqan. Kamachina wasinqa San Antonio de Sonomoro, Pangoa distrito, Satipo provincia, Junín llaqtapin kachkan."
      }
    }
  },
  "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31": {
    "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31",
    "tipo": "Unidad Orgánica",
    "alias": "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "La Compañía Especial de Comandos «Pachacútec» Nº 31, es una pequeña unidad orgánica de la 31ª Brigada de Infantería. Tiene su actividad operacional desde comienzos de la década de 1990. Fue organizada para ejecutar operaciones especiales, reconocimiento, acción directa y lucha contraterrorista en la selva central y el VRAEM. Ha participado activamente en el proceso de pacificación nacional, operando en zonas de Pichanaki, Villa Rica, Satipo, Pangoa y Vizcatán del Ene. El 25 de junio de 2019 perdió a tres integrantes durante operaciones de reconocimiento y combate cerca de Valle Manantial, en el VRAEM.\n\nSu sede actual se encuentra en San Antonio de Sonomoro, distrito de Pangoa, provincia de Satipo, Junín.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31",
        "resena": "La Compañía Especial de Comandos «Pachacútec» Nº 31, es una pequeña unidad orgánica de la 31ª Brigada de Infantería. Tiene su actividad operacional desde comienzos de la década de 1990. Fue organizada para ejecutar operaciones especiales, reconocimiento, acción directa y lucha contraterrorista en la selva central y el VRAEM. Ha participado activamente en el proceso de pacificación nacional, operando en zonas de Pichanaki, Villa Rica, Satipo, Pangoa y Vizcatán del Ene. El 25 de junio de 2019 perdió a tres integrantes durante operaciones de reconocimiento y combate cerca de Valle Manantial, en el VRAEM.\n\nSu sede actual se encuentra en San Antonio de Sonomoro, distrito de Pangoa, provincia de Satipo, Junín."
      },
      "en": {
        "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31",
        "resena": "The Compañía Especial de Comandos «Pachacútec» Nº 31 is a small organic unit of the 31ª Brigada de Infantería. It has been operational since the early 1990s. It was organized to conduct special operations, reconnaissance, direct action, and counterterrorism in the central jungle and the VRAEM. It has actively participated in the national pacification process, operating in Pichanaki, Villa Rica, Satipo, Pangoa, and Vizcatán del Ene. On June 25, 2019, it lost three members during reconnaissance and combat operations near Valle Manantial, in the VRAEM. Its current headquarters are in San Antonio de Sonomoro, distrito de Pangoa, provincia de Satipo, Junín."
      },
      "qu": {
        "nombre": "COMPAÑÍA ESPECIAL DE COMANDOS “PACHACUTEC” N° 31",
        "resena": "Compañía Especial de Comandos «Pachacútec» Nº 31qa 31ª Brigada de Infantería-pa pequeña unidad orgánican. 1990 watakunapa qallariyninmantapacha operaciones ruwan. Selva central chaymanta VRAEM nisqapi operaciones especiales, reconocimiento, acción directa y lucha contraterrorista ruwanapaq wakichisqa karqan. Pacificación nacionalpi Pichanaki, Villa Rica, Satipo, Pangoa y Vizcatán del Ene kitikunapi ancha yanaparqan. 25 junio 2019 p'unchaw VRAEM nisqapi Valle Manantial qayllapi reconocimiento chaymanta combate operaciones ruwachkaptin kimsa runanta chinkachirqan. Kamachina wasinqa San Antonio de Sonomoro, Pangoa distrito, Satipo provincia, Junín llaqtapin kachkan."
      }
    }
  },
  "batallncontraterroristacrlbuenaventuraaguirren314": {
    "nombre": "BATALLÓN CONTRATERRORISTA “ CRL BUENAVENTURA AGUIRRE” N° 314",
    "tipo": "Unidad Orgánica",
    "alias": "BATALLÓN CONTRATERRORISTA “ CRL BUENAVENTURA AGUIRRE” N° 314",
    "sede": "Ejército del Perú",
    "creacion": "Ejército del Perú",
    "resena": "Fue creado como Batallón de Infantería de Reserva Nº 103 mediante el Decreto Supremo Nº 014-79 GU/DIPLANO, del 13 de diciembre de 1979, y activado el 1 de enero de 1980. El 29 de diciembre de 1981 recibió la denominación de Batallón de Infantería “Crl Buenaventura Aguirre” N.º 314, evolucionando posteriormente a unidad contraterrorista. Entre 1988 y 1990 operó en Huánuco contra las columnas terroristas, logrando capturas y recuperando armamento, municiones y propaganda subversiva.\n\nDurante el conflicto del Alto Cenepa de 1995 participó en acciones ofensivas en el PV-1 y las cotas 1240 y 1061, aproximándose al sector de Tiwinza hasta el cese del fuego. Su puesto de comando se encuentra en Kepashiato, distrito de Kumpirushiato, provincia de La Convención, Cusco.",
    "escudo": "/assets/divisiones/escudo_ejercito.png",
    "unidades": [],
    "language": {
      "es": {
        "nombre": "BATALLÓN CONTRATERRORISTA “ CRL BUENAVENTURA AGUIRRE” N° 314",
        "resena": "Fue creado como Batallón de Infantería de Reserva Nº 103 mediante el Decreto Supremo Nº 014-79 GU/DIPLANO, del 13 de diciembre de 1979, y activado el 1 de enero de 1980. El 29 de diciembre de 1981 recibió la denominación de Batallón de Infantería “Crl Buenaventura Aguirre” N.º 314, evolucionando posteriormente a unidad contraterrorista. Entre 1988 y 1990 operó en Huánuco contra las columnas terroristas, logrando capturas y recuperando armamento, municiones y propaganda subversiva.\n\nDurante el conflicto del Alto Cenepa de 1995 participó en acciones ofensivas en el PV-1 y las cotas 1240 y 1061, aproximándose al sector de Tiwinza hasta el cese del fuego. Su puesto de comando se encuentra en Kepashiato, distrito de Kumpirushiato, provincia de La Convención, Cusco."
      },
      "en": {
        "nombre": "BATALLÓN CONTRATERRORISTA “ CRL BUENAVENTURA AGUIRRE” N° 314",
        "resena": "It was created as Batallón de Infantería de Reserva Nº 103 by Decreto Supremo Nº 014-79 GU/DIPLANO of December 13, 1979, and activated on January 1, 1980. On December 29, 1981, it was named Batallón de Infantería “Crl Buenaventura Aguirre” N.º 314, later evolving into a counterterrorism unit. Between 1988 and 1990, it operated in Huánuco against terrorist columns, making captures and recovering weapons, ammunition, and subversive propaganda. During the conflicto del Alto Cenepa of 1995, it participated in offensive actions at PV-1 and elevations 1240 and 1061, approaching the sector de Tiwinza until the ceasefire. Its command post is in Kepashiato, distrito de Kumpirushiato, provincia de La Convención, Cusco."
      },
      "qu": {
        "nombre": "BATALLÓN CONTRATERRORISTA “ CRL BUENAVENTURA AGUIRRE” N° 314",
        "resena": "Decreto Supremo Nº 014-79 GU/DIPLANO, 13 diciembre 1979 kamachiywan Batallón de Infantería de Reserva Nº 103 hina kamasqa, 1 enero 1980 p'unchaw llamk'achisqa karqan. 29 diciembre 1981 p'unchaw Batallón de Infantería “Crl Buenaventura Aguirre” N.º 314 sutita chaskirqan; qhipaman unidad contraterrorista tukurqan. 1988–1990 watakunapi Huánuco llaqtapi columnas terroristas contra operaciones ruwaspa runakunata hap'irqan, armamento, municiones y propaganda subversiva kutichirqan. Conflicto del Alto Cenepa, 1995 pachapi PV-1 chaymanta cotas 1240 y 1061 nisqapi acciones ofensivas ruwarqan; cese del fuego kamakama Tiwinza sector-man qayllaykurqan. Puesto de comando-ninqa Kepashiato, Kumpirushiato distrito, La Convención provincia, Cusco llaqtapin kachkan."
      }
    }
  },
